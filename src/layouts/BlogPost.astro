---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	postId: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	postId,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.share-link {
				margin: 2rem 0;
				text-align: center;
			}

			.share-link button {
				padding: 0.7rem 1.2rem;
				border: 1px solid rgba(168, 85, 247, 0.45);
				border-radius: 999px;
				background: rgba(168, 85, 247, 0.08);
				color: rgb(192, 132, 252);
				font: inherit;
				font-weight: 600;
				cursor: pointer;
				transition:
					background 0.2s ease,
					border-color 0.2s ease,
					transform 0.2s ease;
			}

			.share-link button:hover {
				background: rgba(168, 85, 247, 0.16);
				border-color: rgba(192, 132, 252, 0.7);
				transform: translateY(-1px);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					<div class="share-link">
						<button id="copy-link" type="button">🔗 Copy Link</button>
					</div>
                    <section class="community-locked">
						<div class="community-locked-content" inert aria-hidden="true">
							<p class="community-eyebrow">RISE // COMMUNITY</p>
							<h2>Join the Discussion</h2>
							<p class="community-intro">
								Share your thoughts, connect with builders, and be part of the conversation.
							</p>

							<div class="community-placeholder">
								<div class="placeholder-post">
									<strong>Community discussion</strong>
									<p>Comments and reactions will appear here...</p>
								</div>
								<div class="placeholder-actions">
									<button type="button" disabled>♡ Like</button>
									<button type="button" disabled>Reply</button>
								</div>
								<textarea rows="3" disabled placeholder="Write a comment..."></textarea>
								<button type="button" disabled>Post Comment</button>
							</div>
						</div>

						<div class="community-lock-overlay" role="status">
							<div class="community-lock-strip">
								<span>🔒 LOCKED</span>
							</div>

							<div class="community-lock-message">
								<p class="community-eyebrow">RISE // COMMUNITY</p>
								<h2>Community Under Development</h2>
								<p>
									A space for builders, creators, and curious minds.
									The RISE Community will open when it is ready.
								</p>
							</div>
						</div>
					</section>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	const copyButton = document.querySelector('#copy-link');

	if (copyButton instanceof HTMLButtonElement) {
		copyButton.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);

				copyButton.textContent = '✓ Link Copied!';

				setTimeout(() => {
					copyButton.textContent = '🔗 Copy Link';
				}, 2000);
			} catch (error) {
				console.error('Could not copy link:', error);
				copyButton.textContent = 'Copy failed';

				setTimeout(() => {
					copyButton.textContent = '🔗 Copy Link';
				}, 2000);
			}
		});
	}
</script>

<style>
	/* Locked community preview */
	.community-locked {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 430px;
		margin: 3rem 0 1rem;
		padding: 1.5rem;
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 16px;
		background: rgba(12, 8, 20, 0.5);
	}

	.community-locked-content {
		filter: blur(7px);
		opacity: 0.4;
		pointer-events: none;
		user-select: none;
	}

	.community-eyebrow {
		color: #c084fc;
		font-family: monospace;
		font-size: 0.8rem;
		letter-spacing: 0.15em;
		text-align: center;
	}

	.community-locked-content h2 {
		text-align: center;
	}

	.community-intro {
		text-align: center;
		color: rgb(var(--gray));
	}

	.community-placeholder {
		max-width: 560px;
		margin: 2rem auto;
		padding: 1.2rem;
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 12px;
		background: rgba(168, 85, 247, 0.04);
	}

	.placeholder-post {
		padding: 1rem;
		border-radius: 10px;
		background: rgba(168, 85, 247, 0.08);
	}

	.placeholder-actions {
		display: flex;
		gap: 1rem;
		margin: 1rem 0;
	}

	.community-placeholder textarea {
		box-sizing: border-box;
		width: 100%;
		margin: 0.5rem 0;
		padding: 0.8rem;
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 8px;
		resize: none;
	}

	.community-placeholder button {
		padding: 0.6rem 1rem;
		border: 1px solid rgba(168, 85, 247, 0.2);
		border-radius: 8px;
	}

	.community-lock-overlay {
		position: absolute;
		inset: 0;
		z-index: 10;
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: 1.5rem;
		background: rgba(8, 6, 14, 0.2);
	}

	.community-lock-strip {
		position: absolute;
		top: 38%;
		left: -15%;
		width: 130%;
		padding: 16px 0;
		transform: rotate(-14deg);
		text-align: center;
		background: linear-gradient(
			90deg,
			#6d28d9,
			#a855f7,
			#6d28d9
		);
		border-top: 1px solid #c084fc;
		border-bottom: 1px solid #c084fc;
		box-shadow: 0 0 35px rgba(168, 85, 247, 0.4);
	}

	.community-lock-strip span {
		color: #fff;
		font-family: monospace;
		font-size: clamp(2.2rem, 8vw, 5rem);
		font-weight: 900;
		letter-spacing: 0.2em;
		text-shadow: 0 0 18px rgba(255, 255, 255, 0.25);
	}

	.community-lock-message {
		position: relative;
		z-index: 2;
		width: min(100%, 460px);
		margin-top: 150px;
		padding: 1.4rem;
		text-align: center;
		background: rgba(12, 8, 20, 0.92);
		border: 1px solid rgba(168, 85, 247, 0.4);
		border-radius: 16px;
		box-shadow: 0 0 30px rgba(168, 85, 247, 0.12);
		backdrop-filter: blur(12px);
	}

	.community-lock-message h2 {
		margin: 0.5rem 0;
		color: #fff;
		font-size: clamp(1.25rem, 4vw, 1.8rem);
	}

	.community-lock-message > p:last-child {
		margin: 0;
		color: rgba(255, 255, 255, 0.68);
		line-height: 1.7;
	}

	@media (max-width: 600px) {
		.community-locked {
			min-height: 390px;
			padding: 1.2rem;
		}

		.community-lock-strip {
			top: 35%;
		}

		.community-lock-message {
			margin-top: 130px;
			padding: 1.1rem;
		}
	}
</style>
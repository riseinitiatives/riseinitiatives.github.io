		</a>
		</div>
		
	</nav>
</header>

<style>
	header {
		background: rgba(11, 8, 16, 0.88);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(168, 85, 247, 0.15);
		position: relative;
		z-index: 10;
	}

	nav {
		height: 72px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		padding: 0 1.2rem;
	}

	/* LEFT LOGO */
	.header-logo {
		position: absolute;
		left: 1.2em;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0;
		margin: 0;

		border: none !important;
		background: none !important;
		box-shadow: none !important;
	}

	.header-logo img {
		width: 52px;
		height: 52px;
		object-fit: contain;
	}

	/* CENTER NAVIGATION */
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.internal-links a {
		padding: 0.55em 1em;
		margin: 0 0.15em;

		color: #f5f3ff;
		border: 2px solid transparent;
		border-radius: 999px;

		text-decoration: none;
		transition: all 0.35s ease;
	}

	.internal-links a:hover {
		color: #ffffff;
		border-color: #4cffed;
		background: rgba(53, 255, 235, 0.04);

		box-shadow:
			0 0 6px rgba(11, 255, 231, 0.64),
			0 0 14px rgba(11, 255, 231, 0.28);
	}

	.internal-links a.active {
		color: #ffffff;
		border-color: #bb71ff;
		background: rgba(168, 85, 247, 0.1);

		box-shadow:
			0 0 5px rgb(160, 103, 207),
			0 0 12px rgba(132, 99, 160, 0.58);
	}

	/* RIGHT SOCIAL ICONS */
	.social-links {
		position: absolute;
		right: 1.2rem;

		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0.35rem;
		margin: 0;

		color: #f5f3ffc5;
		text-decoration: none;

		border: none;
		background: transparent;
		box-shadow: none;
		border-radius: 50%;
	}

	.social-links a:hover {
		border: none;
		background: transparent;
	}

	.social-links a.instagram:hover {
		color: #FF0069;
		box-shadow: 0 0 10px rgba(255, 0, 105, 0.35);
	}

	.social-links a.youtube:hover {
		color: #FF0000;
		box-shadow: 0 0 10px rgba(255, 0, 0, 0.35);
	}

	.social-links a.github:hover {
		color: #ffffff;
		box-shadow: 0 0 10px rgba(255, 255, 255, 0.25);
	}

	@media (max-width: 720px) {
		nav {
			height: 64px;
		}

		.header-logo {
			left: 0.6rem;
		}

		.header-logo img {
			width: 44px;
			height: 44px;
		}

		.social-links {
			display: none;
		}

		.internal-links a {
			padding: 0.45em 0.7em;
			margin: 0 0.05em;
		}
	}
	.edge-neon {
		position: fixed;
		top: 0;

		width: clamp(180px, 20vw, 340px);
		height: 100vh;

		pointer-events: none;
		z-index: 1;

		opacity: 0.95;
	}


	/* LEFT */
	.edge-neon-left {
		left: 0;

		background:
			radial-gradient(
				ellipse 100% 130% at 0% 5%,
				rgba(139, 92, 246, 0.58) 0%,
				rgba(139, 92, 246, 0.34) 25%,
				rgba(76, 110, 255, 0.18) 48%,
				rgba(76, 110, 255, 0.07) 70%,
				transparent 92%
			),

			radial-gradient(
				ellipse 70% 120% at 0% 10%,
				rgba(76, 110, 255, 0.20),
				transparent 82%
			);
	}


	/* RIGHT */
	.edge-neon-right {
		right: 0;

		opacity: 0.78;

		background:
			radial-gradient(
				ellipse 90% 125% at 100% 5%,
				rgba(139, 92, 246, 0.50) 0%,
				rgba(139, 92, 246, 0.28) 25%,
				rgba(76, 110, 255, 0.15) 48%,
				rgba(76, 110, 255, 0.06) 70%,
				transparent 92%
			),

			radial-gradient(
				ellipse 62% 115% at 100% 10%,
				rgba(76, 110, 255, 0.17),
				transparent 82%
			);
	}


	/* SMALLER SCREENS */
	@media (max-width: 900px) {
		.edge-neon {
			width: clamp(130px, 22vw, 250px);
			height: 100vh;
		}
	}


	/* MOBILE */
	@media (max-width: 720px) {
		.edge-neon {
			width: 28vw;
			height: 100vh;
		}

		.edge-neon-left {
			opacity: 0.52;
		}

		.edge-neon-right {
			opacity: 0.42;
		}
	}
	.edge-branch {
	position: fixed;
	top: 28%;
	width: clamp(180px, 22vw, 360px);
	height: 65vh;
	pointer-events: none;
	z-index: 2;
	opacity: 0.7;
	}

	/* MAIN CURVED BRANCH */
	.edge-branch::before {
	content: "";
	position: absolute;

	top: 0;
	left: -120px;

	width: 260px;
	height: 420px;

	border-right: 3px solid rgba(187, 113, 255, 0.6);
	border-bottom: 3px solid rgba(139, 92, 246, 0.45);

	border-radius: 0 0 70% 70%;

	transform: rotate(12deg);

	box-shadow:
		0 0 8px rgba(187, 113, 255, 0.45),
		0 0 20px rgba(139, 92, 246, 0.2);
	}

	/* SMALL CURVED OFFSHOOT */
	.edge-branch::after {
	content: "";
	position: absolute;

	top: 150px;
	left: 35px;

	width: 170px;
	height: 130px;

	border-top: 2px solid rgba(187, 113, 255, 0.5);
	border-right: 2px solid rgba(76, 255, 237, 0.2);

	border-radius: 50% 70% 0 0;

	transform: rotate(-20deg);

	box-shadow:
		0 0 7px rgba(187, 113, 255, 0.35);
	}

	/* LEFT */
	.edge-branch-left {
	left: 0;
	}

	/* RIGHT */
	.edge-branch-right {
	right: 0;
	transform: scaleX(-1);
	}

	/* MOBILE */
	@media (max-width: 720px) {
	.edge-branch {
		top: 35%;
		width: 28vw;
		opacity: 0.4;
	}
	}
</style>
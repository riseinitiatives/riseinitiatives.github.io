---
import HeaderLink from './HeaderLink.astro';
---
<div class="edge-neon edge-neon-left"></div>
<div class="edge-neon edge-neon-right"></div>

<div class="edge-branch edge-branch-left"></div>
<div class="edge-branch edge-branch-right"></div>

<header>
	

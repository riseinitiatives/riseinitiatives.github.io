
---
interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<section class="community" data-post-id={postId}>
  <header class="community-header">
    <div>
      <h2>Community</h2>
      <p class="community-subtitle">Share your thoughts with the RISE community.</p>
    </div>
    <div class="community-stats" aria-live="polite">
      <span>❤️ <strong class="like-count">0</strong> Likes</span>
      <span>💬 <strong class="comment-count">0</strong> Comments</span>
    </div>
  </header>

  <button class="like-button" type="button" disabled>
    ❤️ Like
  </button>

  <p class="community-status" role="status" aria-live="polite"></p>

	<div class="comment-form">
	<div class="composer-heading">
		<div>
		<h3>Join the conversation</h3>
		<p>Share your thoughts with the RISE community.</p>
		</div>
		<span class="composer-icon" aria-hidden="true">✦</span>
	</div>

	

	<div class="composer-editor">
		<label for={`comment-${postId}`}>Your comment</label>
		<textarea
		id={`comment-${postId}`}
		class="comment-input"
		maxlength="500"
		placeholder="What's on your mind? Share an idea, ask a question, or start a discussion..."
		rows="5"
		disabled
		></textarea>
		<div class="composer-footer">
		<span class="composer-hint">Be thoughtful. Build the community.</span>
		<button class="comment-submit" type="button" disabled>
			Post Comment <span aria-hidden="true">↗</span>
		</button>
		</div>
	</div>
	</div>

  	<div class="community-divider"><span>✦</span></div>

  <section class="comments-section" aria-label="Comments">
    <h3>Comments</h3>
    <div class="comments-list" aria-live="polite">
      <p class="comments-loading">Loading comments…</p>
    </div>
  </section>
</section>

<script>
  import { supabase } from '../lib/supabase';
	import {
		loadUserBadges,
		renderUserBadges,
	} from '../lib/userBadges';

  type Profile = {
    id: string;
    username: string;
    avatar_url: string | null;
  };

  type CommentRecord = {
    id: string;
    post_id: string;
    user_id: string;
    display_name: string;
    body: string;
    created_at: string;
    parent_id: string | null;
    avatar_url?: string | null;
    replies: CommentRecord[];
  };

  const roots = document.querySelectorAll<HTMLElement>('.community');

  roots.forEach((root) => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const postId = root.dataset.postId;
    if (!postId) return;

    const $ = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector);

    const likeButton = $('.like-button') as HTMLButtonElement | null;
    const likeCount = $('.like-count');
    const commentCount = $('.comment-count');
    const nameInput = $('.display-name') as HTMLInputElement | null;
    const commentInput = $('.comment-input') as HTMLTextAreaElement | null;
    const commentSubmit = $('.comment-submit') as HTMLButtonElement | null;
    const commentsList = $('.comments-list');
    const status = $('.community-status');

    let currentUserId: string | null = null;
    let currentProfile: Profile | null = null;
    let busy = false;
    let refreshToken = 0;
	let userBadges = new Map<
	string,
	('dev_verified' | 'collaborator')[]
	>();

    function setStatus(message: string, isError = false) {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', isError);
    }

    function setFormEnabled(enabled: boolean) {
      if (commentInput) commentInput.disabled = !enabled;
      if (commentSubmit) commentSubmit.disabled = !enabled;
      if (likeButton) likeButton.disabled = !enabled;
    }

    function showAuthMessage(message: string, href: string, linkText: string) {
      const form = $('.comment-form');
      if (!form) return;

      form.replaceChildren();

      const text = document.createElement('p');
      text.className = 'auth-message-text';
      text.textContent = message;

      const link = document.createElement('a');
      link.href = href;
      link.className = 'auth-message-link';
      link.textContent = linkText;

      form.append(text, link);
    }

    function formatDate(value: string) {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return new Intl.DateTimeFormat(undefined, {
        dateStyle: 'medium',
        timeStyle: 'short',
      }).format(date);
    }

    function makeButton(text: string, className: string) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.textContent = text;
      return button;
    }


	function addReportForm(
		comment: CommentRecord,
		wrapper: HTMLElement,
		reportButton: HTMLButtonElement
		) {
		if (!currentUserId || !currentProfile) {
			setStatus('Sign in with your RISE account to report a comment.', true);
			return;
		}

		if (comment.user_id === currentUserId) return;

		// Avoid opening multiple report forms for the same comment.
		if (wrapper.querySelector('.report-form')) return;

		const form = document.createElement('form');
		form.className = 'report-form';

		const heading = document.createElement('strong');
		heading.className = 'report-heading';
		heading.textContent = 'Report this comment';

		const reasonLabel = document.createElement('label');
		reasonLabel.textContent = 'Why are you reporting it?';

		const reason = document.createElement('select');
		reason.required = true;
		reason.className = 'report-reason';

		const placeholder = document.createElement('option');
		placeholder.value = '';
		placeholder.textContent = 'Choose a reason';
		placeholder.disabled = true;
		placeholder.selected = true;
		reason.appendChild(placeholder);

		const reasons = [
			'Spam or unwanted promotion',
			'Harassment or bullying',
			'Inappropriate content',
			'Misinformation',
			'Other',
		];

		for (const value of reasons) {
			const option = document.createElement('option');
			option.value = value;
			option.textContent = value;
			reason.appendChild(option);
		}

		const detailsLabel = document.createElement('label');
		detailsLabel.textContent = 'Additional details (optional)';

		const details = document.createElement('textarea');
		details.className = 'report-details';
		details.maxLength = 1000;
		details.rows = 3;
		details.placeholder = 'Add context for the moderators…';

		const controls = document.createElement('div');
		controls.className = 'report-form-actions';

		const cancel = makeButton('Cancel', 'report-cancel');

		const submit = document.createElement('button');
		submit.type = 'submit';
		submit.className = 'report-submit';
		submit.textContent = 'Submit report';

		let submitting = false;

		cancel.addEventListener('click', () => {
			form.remove();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			if (submitting || !currentUserId || !reason.value) return;

			submitting = true;
			submit.disabled = true;
			cancel.disabled = true;
			submit.textContent = 'Submitting…';

			try {
			const { error } = await supabase
				.from('comment_reports')
				.insert({
				comment_id: comment.id,
				post_id: postId,
				reporter_id: currentUserId,
				reason: reason.value,
				details: details.value.trim() || null,
				});

			if (error) {
				if (error.code === '23505') {
				throw new Error('You have already reported this comment.');
				}
				throw error;
			}

			form.remove();
			reportButton.disabled = true;
			reportButton.textContent = '⚑ Reported';
			setStatus('Thanks. Your report has been submitted.');
			} catch (error) {
			console.error('Comment report failed:', error);
			setStatus(
				error instanceof Error
				? error.message
				: 'Could not submit your report. Please try again.',
				true
			);

			submitting = false;
			submit.disabled = false;
			cancel.disabled = false;
			submit.textContent = 'Submit report';
			}
		});

		controls.append(cancel, submit);
		form.append(
			heading,
			reasonLabel,
			reason,
			detailsLabel,
			details,
			controls
		);

		wrapper.appendChild(form);
		reason.focus();
	}



    function renderComment(comment: CommentRecord, depth = 0): HTMLElement {
      const wrapper = document.createElement('div');
      wrapper.className = 'comment-wrapper';

      const article = document.createElement('article');
      article.className = 'comment';
      if (depth > 0) article.classList.add('comment-reply');
      article.style.setProperty('--reply-depth', String(Math.min(depth, 4)));

      const authorRow = document.createElement('div');
      authorRow.className = 'comment-author';

      const avatar = document.createElement('div');
      avatar.className = 'comment-avatar';
      avatar.setAttribute('aria-hidden', 'true');

      const avatarUrl = comment.avatar_url;
      if (avatarUrl) {
        try {
          const parsed = new URL(avatarUrl);
          if (parsed.protocol === 'https:' || parsed.protocol === 'http:') {
            const image = document.createElement('img');
            image.src = parsed.href;
            image.alt = '';
            image.loading = 'lazy';
            image.referrerPolicy = 'no-referrer';
            image.onerror = () => {
              avatar.textContent = (comment.display_name || 'U').charAt(0).toUpperCase();
            };
            avatar.appendChild(image);
          } else {
            avatar.textContent = (comment.display_name || 'U').charAt(0).toUpperCase();
          }
        } catch {
          avatar.textContent = (comment.display_name || 'U').charAt(0).toUpperCase();
        }
      } else {
        avatar.textContent = (comment.display_name || 'U').charAt(0).toUpperCase();
      }

      	const author = document.createElement('strong');
		author.className = 'comment-username';
		author.textContent = `@${comment.display_name || 'unknown'}`;

		const badgeContainer = document.createElement('span');
		badgeContainer.className = 'comment-user-badges';
		badgeContainer.innerHTML = renderUserBadges(
		comment.user_id,
		userBadges
		);

      const date = document.createElement('time');
      date.className = 'comment-date';
      date.dateTime = comment.created_at;
      date.textContent = formatDate(comment.created_at);

      authorRow.append(avatar, author, badgeContainer, date);

      const body = document.createElement('p');
      body.className = 'comment-body';
      body.textContent = comment.body;

	    const actions = document.createElement('div');
		actions.className = 'comment-actions';

		const replyButton = makeButton('↩ Reply', 'reply-button');
		actions.appendChild(replyButton);

		// Show Report for another user's comment.
		if (currentUserId && comment.user_id !== currentUserId) {
		const reportButton = makeButton('⚑ Report', 'report-button');

		reportButton.addEventListener('click', () => {
			addReportForm(comment, wrapper, reportButton);
		});

		actions.appendChild(reportButton);
		}

      if (currentUserId && comment.user_id === currentUserId) {
        const deleteButton = makeButton('Delete', 'delete-button');
        deleteButton.addEventListener('click', async () => {
          if (!currentUserId || !confirm('Delete this comment and its replies?')) return;

          deleteButton.disabled = true;
          deleteButton.textContent = 'Deleting…';

          try {
            // Delete descendants first because parent_id may not cascade.
            const { data: allComments, error: fetchError } = await supabase
              .from('comments')
              .select('id, parent_id, user_id')
              .eq('post_id', postId);

            if (fetchError) throw fetchError;

            const rows = allComments ?? [];
            const descendants = new Set<string>([comment.id]);
            let changed = true;

            while (changed) {
              changed = false;
              for (const row of rows) {
                if (
                  row.parent_id &&
                  descendants.has(row.parent_id) &&
                  !descendants.has(row.id)
                ) {
                  descendants.add(row.id);
                  changed = true;
                }
              }
            }

            // The RLS policy only permits deleting one's own comments.
            // If a descendant belongs to another user, abort rather than
            // leave a partially deleted thread.
            const foreignDescendant = rows.some(
              (row) => descendants.has(row.id) && row.user_id !== currentUserId
            );
            if (foreignDescendant) {
              throw new Error(
                'This thread contains replies by other users. The full thread cannot be deleted with the current permissions.'
              );
            }

            for (const id of descendants) {
              const { error } = await supabase
                .from('comments')
                .delete()
                .eq('id', id)
                .eq('user_id', currentUserId);

              if (error) throw error;
            }

            setStatus('Comment deleted.');
            await loadCommunity();
          } catch (error) {
            console.error('Comment deletion failed:', error);
            setStatus(
              error instanceof Error ? error.message : 'Could not delete the comment.',
              true
            );
            deleteButton.disabled = false;
            deleteButton.textContent = 'Delete';
          }
        });
        actions.appendChild(deleteButton);
      }

      const bodyPanel = document.createElement('div');
      bodyPanel.className = 'comment-content';
      bodyPanel.append(body, actions);

      article.append(authorRow, bodyPanel);
      wrapper.appendChild(article);

      replyButton.addEventListener('click', () => {
        const existing = wrapper.querySelector('.reply-form');
        if (existing) {
          existing.remove();
          replyButton.textContent = '↩ Reply';
          return;
        }

        if (!currentUserId || !currentProfile) {
          setStatus('Sign in with your RISE account to reply.', true);
          return;
        }

        const form = document.createElement('form');
        form.className = 'reply-form';

        const textarea = document.createElement('textarea');
        textarea.maxLength = 1000;
        textarea.rows = 3;
        textarea.required = true;
        textarea.placeholder = `Reply to @${comment.display_name}…`;

        const controls = document.createElement('div');
        controls.className = 'reply-form-actions';

        const cancel = makeButton('Cancel', 'reply-cancel');
        const submit = document.createElement('button');
        submit.type = 'submit';
        submit.className = 'reply-submit';
        submit.textContent = 'Post Reply';

        cancel.addEventListener('click', () => {
          form.remove();
          replyButton.textContent = '↩ Reply';
        });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const bodyText = textarea.value.trim();
          if (!bodyText || !currentUserId || !currentProfile) return;

          submit.disabled = true;
          cancel.disabled = true;
          submit.textContent = 'Posting…';

          try {
            const { error } = await supabase.from('comments').insert({
              post_id: postId,
              user_id: currentUserId,
              display_name: currentProfile.username,
              body: bodyText,
              parent_id: comment.id,
            });

            if (error) throw error;

            setStatus('Reply posted.');
            await loadCommunity();
          } catch (error) {
            console.error('Reply submission failed:', error);
            setStatus(
              error instanceof Error ? error.message : 'Could not post your reply.',
              true
            );
            submit.disabled = false;
            cancel.disabled = false;
            submit.textContent = 'Post Reply';
          }
        });

        controls.append(cancel, submit);
        form.append(textarea, controls);
        wrapper.appendChild(form);
        replyButton.textContent = 'Close reply';
        textarea.focus();
      });

      if (comment.replies.length > 0) {
		const thread = document.createElement('div');
		thread.className = 'comment-thread';

		const replies = document.createElement('div');
		replies.className = 'replies';
		replies.hidden = true;

		const replyCount = comment.replies.length;

		const controls = document.createElement('div');
		controls.className = 'thread-controls';

		const toggle = makeButton(
			`${replyCount} ${replyCount === 1 ? 'reply' : 'replies'} ▾`,
			'reply-toggle'
		);
		toggle.setAttribute('aria-expanded', 'false');

	
		// Expand or collapse replies independently.
		toggle.addEventListener('click', () => {
			if (bodyPanel.hidden) return;

			replies.hidden = !replies.hidden;
			toggle.setAttribute('aria-expanded', String(!replies.hidden));
			toggle.textContent = replies.hidden
			? `${replyCount} ${replyCount === 1 ? 'reply' : 'replies'} ▾`
			: `${replyCount} ${replyCount === 1 ? 'reply' : 'replies'} ▴`;
		});

		for (const reply of comment.replies) {
			replies.appendChild(renderComment(reply, depth + 1));
		}

		controls.append(toggle);
		thread.append(controls, replies);
		wrapper.appendChild(thread);
        
		}


		
		return wrapper;
    
    } 

    async function loadCommunity() {
      const token = ++refreshToken;
      if (!commentsList) return;

      const { data: comments, error: commentsError } = await supabase
        .from('comments')
        .select('id, post_id, user_id, display_name, body, created_at, parent_id')
        .eq('post_id', postId)
        .order('created_at', { ascending: true });

      if (token !== refreshToken) return;
      if (commentsError) {
        console.error('Could not load comments:', commentsError);
        setStatus('Comments could not be loaded. Please refresh and try again.', true);
        return;
      }

      	const rows = comments ?? [];
		const userIds = [...new Set(rows.map((comment) => comment.user_id))];

		userBadges = await loadUserBadges(supabase, userIds);
      let profiles = new Map<string, Profile>();

      if (userIds.length > 0) {
        const { data, error } = await supabase
          .from('profiles')
          .select('id, username, avatar_url')
          .in('id', userIds);

        if (error) {
          console.warn('Could not load comment profiles:', error);
        } else {
          profiles = new Map((data ?? []).map((profile) => [profile.id, profile]));
        }
      }

      if (token !== refreshToken) return;

      const commentMap = new Map<string, CommentRecord>();
      for (const row of rows) {
        commentMap.set(row.id, {
          ...row,
          avatar_url: profiles.get(row.user_id)?.avatar_url ?? null,
          replies: [],
        });
      }

      const topLevel: CommentRecord[] = [];
      for (const row of rows) {
        const comment = commentMap.get(row.id)!;
        const parent = row.parent_id ? commentMap.get(row.parent_id) : undefined;
        if (parent && parent.id !== comment.id) {
          parent.replies.push(comment);
        } else {
          topLevel.push(comment);
        }
      }

      const [{ count: likes, error: likesError }, { data: userLike, error: userLikeError }] =
        await Promise.all([
          supabase
            .from('likes')
            .select('id', { count: 'exact', head: true })
            .eq('post_id', postId),
          currentUserId
            ? supabase
                .from('likes')
                .select('id')
                .eq('post_id', postId)
                .eq('user_id', currentUserId)
                .maybeSingle()
            : Promise.resolve({ data: null, error: null }),
        ]);

      if (token !== refreshToken) return;

      if (likesError) {
        console.error('Could not load likes:', likesError);
        setStatus('Like count could not be loaded.', true);
      }
      if (userLikeError) {
        console.warn('Could not check the current user like:', userLikeError);
      }

      if (likeCount) likeCount.textContent = String(likes ?? 0);
      if (commentCount) commentCount.textContent = String(rows.length);

      if (likeButton) {
        likeButton.textContent = userLike ? '❤️ Liked' : '❤️ Like';
        likeButton.setAttribute('aria-pressed', String(Boolean(userLike)));
      }

      commentsList.replaceChildren();

      if (topLevel.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'comments-empty';
        empty.textContent = 'No comments yet. Start the conversation!';
        commentsList.appendChild(empty);
      } else {
        for (const comment of topLevel) {
          commentsList.appendChild(renderComment(comment));
        }
      }
    }

    async function initialize() {
      setFormEnabled(false);

      try {
        const { data, error } = await supabase.auth.getSession();

        if (error) throw error;

        const user = data.session?.user ?? null;

        const user = data.user;
        const anonymous =
          (user as (typeof user & { is_anonymous?: boolean }) | null)
            ?.is_anonymous === true ||
          user?.app_metadata?.is_anonymous === true;

        if (!user || anonymous) {
          showAuthMessage('Sign in with your RISE account to comment and like.', '/login', 'Sign in');
          setStatus('You can browse the discussion while signed out.');
          await loadCommunity();
          return;
        }

        currentUserId = user.id;

        const { data: profile, error: profileError } = await supabase
          .from('profiles')
          .select('id, username, avatar_url')
          .eq('id', user.id)
          .maybeSingle();

        if (profileError) throw profileError;

        if (!profile) {
          showAuthMessage('Create your RISE ID to join the discussion.', '/setup-profile', 'Create RISE ID');
          setStatus('Your profile is needed before posting.');
          await loadCommunity();
          return;
        }

        currentProfile = profile;
        if (nameInput) {
          nameInput.value = `@${profile.username}`;
          nameInput.readOnly = true;
        }

        setFormEnabled(true);
        setStatus('');
        await loadCommunity();
      } catch (error) {
        console.error('Community initialization failed:', error);
        setStatus('The community could not initialize. Please refresh the page.', true);
        if (commentsList) {
          commentsList.replaceChildren();
          const message = document.createElement('p');
          message.className = 'comments-empty';
          message.textContent = 'Comments are temporarily unavailable.';
          commentsList.appendChild(message);
        }
      }
    }

    likeButton?.addEventListener('click', async () => {
      if (!currentUserId || busy || !likeButton) return;

      busy = true;
      likeButton.disabled = true;
      const previousText = likeButton.textContent;
      likeButton.textContent = 'Updating…';

      try {
        const { data: existing, error: checkError } = await supabase
          .from('likes')
          .select('id')
          .eq('post_id', postId)
          .eq('user_id', currentUserId)
          .maybeSingle();

        if (checkError) throw checkError;

        if (existing) {
          const { error } = await supabase
            .from('likes')
            .delete()
            .eq('id', existing.id)
            .eq('user_id', currentUserId);
          if (error) throw error;
        } else {
          const { error } = await supabase.from('likes').insert({
            post_id: postId,
            user_id: currentUserId,
          });
          if (error) throw error;
        }

        setStatus('');
        await loadCommunity();
      } catch (error) {
        console.error('Like update failed:', error);
        setStatus(
          error instanceof Error ? error.message : 'Could not update your like.',
          true
        );
        likeButton.textContent = previousText || '❤️ Like';
      } finally {
        busy = false;
        likeButton.disabled = !currentUserId;
      }
    });

    commentSubmit?.addEventListener('click', async () => {
      if (!currentUserId || !currentProfile || busy || !commentInput || !commentSubmit) return;

      const body = commentInput.value.trim();
      if (!body) {
        setStatus('Please write a comment first.', true);
        commentInput.focus();
        return;
      }

      busy = true;
      commentSubmit.disabled = true;
      commentSubmit.textContent = 'Posting…';

      try {
        const { error } = await supabase.from('comments').insert({
          post_id: postId,
          user_id: currentUserId,
          display_name: currentProfile.username,
          body,
          parent_id: null,
        });

        if (error) throw error;

        commentInput.value = '';
        setStatus('Comment posted.');
        await loadCommunity();
      } catch (error) {
        console.error('Comment submission failed:', error);
        setStatus(
          error instanceof Error ? error.message : 'Could not post your comment.',
          true
        );
      } finally {
        busy = false;
        commentSubmit.disabled = !currentUserId;
        commentSubmit.textContent = 'Post Comment';
      }
    });

    initialize();
  });
</script>

<style>
   /* Thread controls */
	:global(.comment-thread) {
	margin: 12px 0 4px 8px;
	min-width: 0;
	}

	:global(.thread-controls) {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 8px;
	margin: 8px 0 10px;
	}

	/* Nested replies */
	:global(.replies) {
	display: grid;
	gap: 10px;
	margin: 0 0 4px 10px;
	padding: 4px 0 4px 14px;
	border-left: 2px solid rgba(168, 85, 247, 0.32);
	}

	:global(.replies[hidden]),

	:global(.comment[hidden]) {
	display: none !important;
	}

	/* Nested comment card */
	:global(.replies .comment) {
	min-width: 0;
	padding: 13px 15px;
	border: 1px solid rgba(168, 85, 247, 0.2);
	border-radius: 12px;
	background:
		linear-gradient(
		135deg,
		rgba(168, 85, 247, 0.09),

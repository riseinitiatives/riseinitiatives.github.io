---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const pageTitle = `Discussion | ${SITE_TITLE}`;
const pageDescription = 'RISE Community discussion';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle}
			description={pageDescription}
		/>
	</head>

	<body>
		<Header />

        <main class="post-locked-page">
            <div class="post-lock-strip">
                <span>🔒 LOCKED</span>
            </div>

            <section class="post-lock-message">
                <p class="eyebrow">RISE // COMMUNITY</p>
                <h1>Discussion locked</h1>
                <p>
                    The RISE Community is currently under development.
                    Individual discussions will return when the
                    community is ready to launch.
                </p>
                <a href="/community">← Back to Community</a>
            </section>
        </main>

		<Footer />
	</body>

	<style>
        .post-locked-page {
            position: relative;
            isolation: isolate;
            display: grid;
            place-items: center;
            min-height: 75vh;
            padding: 2rem 1rem;
            overflow: hidden;
        }

        .post-lock-strip {
            position: absolute;
            top: 40%;
            left: -15%;
            width: 130%;
            padding: 18px;
            transform: rotate(-14deg);
            text-align: center;
            background: linear-gradient(
                90deg,
                #6d28d9,
                #a855f7,
                #6d28d9
            );
            border-block: 1px solid #c084fc;
            box-shadow: 0 0 35px rgba(168, 85, 247, 0.35);
        }

        .post-lock-strip span {
            color: white;
            font-size: clamp(2rem, 8vw, 5rem);
            font-weight: 900;
            letter-spacing: 0.18em;
        }

        .post-lock-message {
            position: relative;
            z-index: 2;
            max-width: 520px;
            padding: 2rem;
            text-align: center;
            color: white;
            background: rgba(12, 8, 20, 0.94);
            border: 1px solid rgba(168, 85, 247, 0.4);
            border-radius: 16px;
        }

        .post-lock-message a {
            display: inline-block;
            margin-top: 1rem;
            color: #c084fc;
        }
        
        
        /* removed */
        .discussion-page {
			min-height: 70vh;
			padding: 110px 24px 100px;
		}

		.discussion-container {
			max-width: 850px;
			margin: 0 auto;
		}

		.discussion-label {
			margin: 0 0 18px;

			color: #0bffe8;

			font-size: 0.7rem;
			font-weight: 800;
			letter-spacing: 0.16em;
		}

		#discussion-loading {
			color: rgba(255, 255, 255, 0.5);
		}

		#discussion-content {
			padding: 30px;

			border: 1px solid rgba(168, 85, 247, 0.2);
			border-radius: 18px;

			background:
				linear-gradient(
					135deg,
					rgba(168, 85, 247, 0.055),
					rgba(255, 255, 255, 0.012)
				);
		}

		.discussion-category {
			margin-bottom: 14px;

			color: #0bffe8;

			font-size: 0.78rem;
			font-weight: 700;
		}

		#discussion-title {
			margin: 0;

			color: #fff;

			font-size: clamp(2rem, 5vw, 3.4rem);
			line-height: 1.1;
			letter-spacing: -0.04em;
		}

		.discussion-author {
			display: flex;
			align-items: center;
			gap: 9px;

			margin-top: 22px;

			color: rgba(255, 255, 255, 0.42);

			font-size: 0.88rem;
		}

		.discussion-avatar {
			display: grid;
			place-items: center;

			width: 32px;
			height: 32px;
			min-width: 32px;

			overflow: hidden;

			border: 1px solid rgba(168, 85, 247, 0.4);
			border-radius: 50%;

			background: rgba(168, 85, 247, 0.1);

			color: #c084fc;

			font-size: 0.75rem;
			font-weight: 800;
		}

		.discussion-avatar img {
			display: block;

			width: 32px;
			height: 32px;

			object-fit: cover;
		}

		.discussion-body {
			margin-top: 32px;

			color: rgba(255, 255, 255, 0.72);

			font-size: 1rem;
			line-height: 1.8;

			white-space: pre-wrap;
		}

		#discussion-error {
			padding: 40px 0;
		}

		#discussion-error h1 {
			margin: 0 0 12px;
		}

		#discussion-error p {
			color: rgba(255, 255, 255, 0.5);
		}

		#discussion-error a {
			display: inline-block;

			margin-top: 12px;

			color: #0bffe8;
			text-decoration: none;
		}

		@media (max-width: 600px) {
			.discussion-page {
				padding-left: 18px;
				padding-right: 18px;
			}

			#discussion-content {
				padding: 22px;
				border-radius: 14px;
			}
		}
        .discussion-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .discussion-actions button {
            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 10px;
            padding: 8px 14px;
            background: rgba(168, 85, 247, 0.06);
            color: rgba(255, 255, 255, 0.65);
            font: inherit;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .discussion-actions button:hover {
            border-color: rgba(168, 85, 247, 0.5);
            background: rgba(168, 85, 247, 0.12);
            color: #fff;
        }

        #upvote-button.active {
            color: #c084fc;
            border-color: rgba(192, 132, 252, 0.5);
            background: rgba(168, 85, 247, 0.14);
        }
        
        .comments-section {
            margin-top: 40px;
        }

        .comments-section h2 {
            margin-bottom: 20px;
            color: #fff;
            font-size: 1.4rem;
        }

       :global(.comment) {
            padding: 15px 5px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        :global(.comment-author) {
            margin-bottom: 1%;
            color: #c084fc;
            font-size: 1.2rem;
            
        }

        :global(.comment-body) {
            margin-left: 40px;
            padding-left: 4px;
            color: rgba(255, 255, 255, 0.72);
            line-height: 1.1;
        }

        :global(.comment-form) {
            margin-top: 28px;
        }

        :global(#comment-input) {
            width: 100%;
            box-sizing: border-box;
            padding: 14px 16px;

            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 12px;

            background: rgba(255, 255, 255, 0.025);
            color: #fff;

            font: inherit;
            line-height: 1.6;

            resize: vertical;
            outline: none;
        }

        :global(#comment-input)::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        :global(#comment-input):focus {
            border-color: rgba(192, 132, 252, 0.55);
            box-shadow: 0 0 18px rgba(168, 85, 247, 0.08);
        }

        :global(#post-comment-button) {
            margin-top: 10px;
            padding: 9px 16px;

            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 10px;

            background: rgba(168, 85, 247, 0.1);
            color: #c084fc;

            font: inherit;
            font-weight: 700;
            cursor: pointer;

            transition: 0.2s ease;
        }

        :global(#post-comment-button):hover {
            background: rgba(168, 85, 247, 0.18);
            border-color: rgba(192, 132, 252, 0.65);
            color: #fff;
            transform: translateY(-1px);
        }

        :global(.comment-header) {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 3px;
        }

        :global(.comment-left) {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        :global(.comment-menu-container) {
            position: relative;
            flex-shrink: 0;
        }

        :global(.comment-avatar) {
            width: 30px;
            height: 30px;
            min-width: 30px;
            min-height: 30px;

            display: flex;
            align-items: left;
            justify-content: left;

            overflow: hidden;

            border: 1px solid rgba(168, 85, 247, 0.35);
            border-radius: 50%;

            background: rgba(168, 85, 247, 0.1);

            color: #c084fc;
            font-size: 0.72rem;
            font-weight: 800;
        }

        :global(.comment-avatar) img {
            display: block;

            width: 100%;
            height: 100%;

            max-width: 100%;
            max-height: 100%;

            object-fit: cover;
        }

        :global(.comment-meta) {
            display: flex;
            align-items: center;
            gap: 8px;

            line-height: .3;
        }

        :global(.comment-time) {
            color: rgba(255, 255, 255, 0.35);
            font-size: 0.9rem;
        }

        :global(.comment-reply) {
            margin-left: 40px;
            margin-top: 6px;
            padding: 0;
            border: none;
            background: none;
            color: rgba(192, 132, 252, 0.65);
            font: inherit;
            font-size: 0.95rem;
            cursor: pointer;
        }

        :global(.comment-reply:hover) {
            color: #c084fc;
        }

        :global(.toggle-replies) {
            display: inline-block;
            margin: 8px 0 4px 40px;
            padding: 5px 10px;

            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 8px;

            background: rgba(168, 85, 247, 0.06);
            color: #c084fc;

            font: inherit;
            font-size: 0.82rem;
            font-weight: 600;

            cursor: pointer;
            transition: all 0.2s ease;
        }

        :global(.toggle-replies:hover) {
            border-color: rgba(11, 255, 232, 0.4);
            background: rgba(168, 85, 247, 0.14);
            color: #0bffe8;
            transform: translateY(-1px);
        }

        :global(.toggle-replies:focus-visible) {
            outline: 2px solid #0bffe8;
            outline-offset: 3px;
        }

        :global(.comment-replies[hidden]) {
            display: none;
        }
        
        :global(.comment-replies) {
            margin-left: 40px;
            margin-top: 4px;
            padding-left: 14px;
            border-left: 1px solid rgba(168, 85, 247, 0.18);
        }

        :global(.reply-comment) {
            padding-top: 10px;
        }
        :global(.reply-form) {
            margin-top: 10px;
            margin-left: 40px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        :global(.reply-input) {
            width: 100%;
            box-sizing: border-box;
            padding: 10px 12px;

            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 10px;

            background: rgba(255, 255, 255, 0.025);
            color: #fff;

            font: inherit;
            line-height: 1.5;

            resize: vertical;
            outline: none;
        }

        :global(.reply-input)::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        :global(.reply-input):focus {
            border-color: rgba(192, 132, 252, 0.55);
            box-shadow: 0 0 14px rgba(168, 85, 247, 0.08);
        }

        :global(.reply-submit) {
            align-self: flex-start;

            padding: 7px 13px;

            border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 8px;

            background: rgba(168, 85, 247, 0.08);
            color: #c084fc;

            font: inherit;
            font-size: 0.78rem;
            font-weight: 700;

            cursor: pointer;
            transition: 0.2s ease;
        }

        :global(.reply-submit:hover) {
            background: rgba(168, 85, 247, 0.16);
            border-color: rgba(192, 132, 252, 0.6);
            color: #fff;
        }

        :global(.comment-delete) {
            margin-left: 8px;
            padding: 0;
            border: none;
            background: none;
            color: rgba(255, 100, 100, 0.55);
            font: inherit;
            font-size: 0.75rem;
            cursor: pointer;
        }

        :global(.comment-delete:hover) {
            color: #ff6b6b;
        }

        .discussion-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
        }

        .discussion-menu-container {
            position: relative;
            flex-shrink: 0;
        }

        :global(.discussion-menu-button) {
            width: 36px;
            height: 36px;

            border: none;
            border-radius: 10px;

            background: transparent;
            color: rgba(255, 255, 255, 0.45);

            font-size: 1.5rem;
            line-height: 1;

            cursor: pointer;
            transition: 0.2s ease;
        }

        :global(.discussion-menu-button:hover) {
            background: rgba(168, 85, 247, 0.1);
            color: #fff;
        }

        :global(.discussion-menu) {
            position: absolute;
            top: 42px;
            right: 0;
            z-index: 20;

            min-width: 120px;

            padding: 6px;

            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 10px;

            background: rgba(18, 12, 28, 0.96);

            box-shadow:
                0 12px 30px rgba(0, 0, 0, 0.35);
        }

        :global(.discussion-menu button) {
            width: 100%;

            padding: 8px 10px;

            border: none;
            border-radius: 7px;

            background: transparent;

            color: #ff6b6b;

            font: inherit;
            font-size: 0.8rem;

            text-align: left;

            cursor: pointer;
        }

        :global(.discussion-menu button:hover) {
            background: rgba(255, 100, 100, 0.08);
        }

        :global(.comment-menu-button) {
            display: grid;
            place-items: center;

            width: 28px;
            height: 28px;
            padding: 0;

            border: 1px solid rgba(168, 85, 247, 0.18);
            border-radius: 7px;

            background: rgba(168, 85, 247, 0.05);
            color: rgba(192, 132, 252, 0.75);

            font-size: 1.2rem;
            line-height: 1;

            cursor: pointer;
            transition: all 0.2s ease;
        }

        :global(.comment-menu-button:hover) {
            border-color: rgba(168, 85, 247, 0.55);
            background: rgba(168, 85, 247, 0.16);
            color: #0bffe8;
            box-shadow: 0 0 12px rgba(168, 85, 247, 0.12);
        }

        :global(.comment-menu) {
            position: absolute;
            top: 30px;
            right: 0;
            z-index: 20;

            min-width: 100px;

            padding: 5px;

            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 9px;

            background: rgba(18, 12, 28, 0.96);

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.35);
        }

        :global(.comment-menu .comment-delete) {
            width: 100%;

            margin: 0;

            padding: 7px 9px;

            border: none;
            border-radius: 6px;

            background: transparent;

            color: #ff6b6b;

            font: inherit;
            font-size: 0.78rem;

            text-align: left;

            cursor: pointer;
        }

        :global(.comment-menu .comment-delete:hover) {
            background: rgba(255, 100, 100, 0.08);
        }
        :global(.comment-menu .comment-report) {
            width: 100%;
            margin: 0;
            padding: 7px 9px;

            border: none;
            border-radius: 6px;

            background: transparent;
            color: #ff8b8b;

            font: inherit;
            font-size: 0.37rem;
            text-align: left;

            cursor: pointer;
        }

        :global(.comment-menu .comment-report:hover) {
            background: rgba(255, 100, 100, 0.08);
        }

        :global(.comment-menu .comment-report) {
            width: 100%;
            margin: 0;
            padding: 7px 9px;
            border: none;
            border-radius: 6px;
            background: transparent;
            color: #ff8b8b;
            font: inherit;
            font-size: 1rem;
            text-align: left;
            cursor: pointer;
        }

        :global(.comment-menu .comment-report:hover) {
            background: rgba(255, 100, 100, 0.08);
        }

        :global(.report-form) {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 12px 0 8px 40px;
            padding: 14px;
            border: 1px solid rgba(168, 85, 247, 0.25);
            border-radius: 10px;
            background: rgba(168, 85, 247, 0.05);
            color: #7c43d8;
        }

        :global(.report-form textarea),
        :global(.report-form select) {
            width: 100%;
            box-sizing: border-box;
            padding: 9px 10px;
            border: 1px solid rgba(168, 85, 247, 0.25);
            border-radius: 8px;
            background: #171020;
            color: #929192;
            font: inherit;
        }

        :global(.report-form-actions) {
            display: flex;
            gap: 8px;
        }

        :global(.report-submit),
        :global(.report-cancel) {
            padding: 7px 11px;
            border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 8px;
            background: rgba(168, 85, 247, 0.1);
            color: #e95959;
            cursor: pointer;
        }

        :global(#comment-status.is-error) {
            color: #ff8b8b;
        }
        :global(.comment-author) {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        }

        :global(.dev-verified-badge) {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;

            width: 18px;
            height: 18px;
            min-width: 18px;
            flex: 0 0 18px;
            box-sizing: border-box;

            border: 1.5px solid #16a34a;
            border-radius: 50% !important;

            background: #16a34a;
            color: #ffffff;

            font-size: 12px;
            font-weight: 900;
            line-height: 1;
            vertical-align: middle;

            box-shadow: 0 0 8px rgba(22, 163, 74, 0.35);
        }
	</style>


</html>
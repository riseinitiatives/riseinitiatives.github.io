---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Create Account | RISE Initiatives"
			description="Create your RISE Initiatives account."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="signup-page">
				<p class="eyebrow">RISE // ACCOUNT</p>

				<h1>Create your account.</h1>

				<p class="intro">
					Join the RISE community and create your unique RISE User ID.
				</p>

				<form id="signup-form">
					<label for="email">Email address</label>

					<input
						id="email"
						type="email"
						placeholder="you@example.com"
						autocomplete="email"
						required
					/>

					<label for="password">Password</label>

					<input
						id="password"
						type="password"
						placeholder="Create a password"
						autocomplete="new-password"
						required
					/>

					<button type="submit">
						Create account
					</button>

					<p id="signup-message"></p>
				</form>
			</section>
		</main>

		<Footer />
	</body>

    <script>
		import { supabase } from '../lib/supabase';

		const form = document.querySelector('#signup-form');
		const emailInput = document.querySelector('#email');
		const passwordInput = document.querySelector('#password');
		const message = document.querySelector('#signup-message');
		const button = form?.querySelector('button');

		let registeredEmail = '';
		let resendCooldown = false;

		function showVerificationState() {
			if (!message) return;

			message.innerHTML = `
				<span>
					Account created! Check your email to confirm your account.
				</span>
				<br />
				<button
					id="resend-verification"
					type="button"
					style="
						width:auto;
						margin-top:0.8rem;
						padding:0.55rem 0.8rem;
						background:transparent;
						border:1px solid rgba(168,85,247,0.35);
						color:#d8d2e2;
					"
				>
					Resend verification email
				</button>
			`;

			const resendButton = document.querySelector('#resend-verification');

			resendButton?.addEventListener('click', async () => {
				if (resendCooldown || !registeredEmail) return;

				resendCooldown = true;
				resendButton.disabled = true;
				resendButton.textContent = 'Sending...';

				const { error } = await supabase.auth.resend({
					type: 'signup',
					email: registeredEmail,
					options: {
						emailRedirectTo: `${window.location.origin}/setup-profile`,
					},
				});

				if (error) {
					console.error('Resend verification error:', error);
					resendButton.textContent = error.message;
					return;
				}

				let seconds = 60;
				resendButton.textContent = `Sent — resend in ${seconds}s`;

				const timer = setInterval(() => {
					seconds--;

					if (seconds <= 0) {
						clearInterval(timer);
						resendCooldown = false;
						resendButton.disabled = false;
						resendButton.textContent = 'Resend verification email';
						return;
					}

					resendButton.textContent = `Sent — resend in ${seconds}s`;
				}, 1000);
			});
		}

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();

			const email = emailInput?.value.trim();
			const password = passwordInput?.value;

			if (!email || !password) return;

			registeredEmail = email;

			if (message) {
				message.textContent = 'Creating your account...';
			}

			if (button) {
				button.disabled = true;
				button.textContent = 'Creating...';
			}

			const { error } = await supabase.auth.signUp({
				email,
				password,
				options: {
					emailRedirectTo: `${window.location.origin}/setup-profile`,
				},
			});

			if (error) {
				console.error('Signup error:', error);

				if (message) {
					message.textContent = error.message;
				}

				if (button) {
					button.disabled = false;
					button.textContent = 'Create account';
				}

				return;
			}

			if (form) {
				form.style.display = 'none';
			}

			showVerificationState();
		});
	</script>

	<style>
		.signup-page {
			width: min(560px, calc(100% - 2rem));
			margin: 6rem auto;
			text-align: center;
		}

		.eyebrow {
			margin: 0 0 1rem;
			font-family: monospace;
			font-size: 0.75rem;
			letter-spacing: 0.16em;
			color: #4cffed;
		}

		h1 {
			margin: 0;
			font-size: clamp(2.4rem, 6vw, 4rem);
			letter-spacing: -0.04em;
		}

		.intro {
			margin: 1rem auto 2.5rem;
			color: #aaa4b9;
			line-height: 1.7;
		}

		form {
			text-align: left;
		}

		label {
			display: block;
			margin: 1rem 0 0.6rem;
			font-size: 0.85rem;
		}

		input {
			width: 100%;
			box-sizing: border-box;
			padding: 0.9rem;
			border: 1px solid rgba(255, 255, 255, 0.12);
			border-radius: 10px;
			background: rgba(255, 255, 255, 0.04);
			color: white;
			font: inherit;
			outline: none;
		}

		input:focus {
			border-color: rgba(168, 85, 247, 0.6);
		}

		button {
			width: 100%;
			margin-top: 1.25rem;
			padding: 0.9rem;
			border: 0;
			border-radius: 10px;
			background: #a855f7;
			color: white;
			font: inherit;
			cursor: pointer;
		}

		button:hover {
			background: #c084fc;
		}

		#signup-message {
			margin-top: 1rem;
			font-size: 0.85rem;
			color: #aaa4b9;
			text-align: center;
		}
	</style>
</html>
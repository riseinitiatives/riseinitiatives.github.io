---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Auth from '../components/Auth.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Login | RISE Initiatives"
			description="Sign in to the RISE Initiatives community."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="login-page">
				<p class="eyebrow">RISE // ACCOUNT</p>

				<h1>Welcome to RISE.</h1>

				<p>
					Sign in to join discussions, share ideas, and connect
					with the community.
				</p>

				<Auth />
			</section>
		</main>

		<Footer />
	</body>

	<style>
		.login-page {
			width: min(600px, calc(100% - 2rem));
			margin: 6rem auto;
			text-align: center;
		}

		.eyebrow {
			margin: 0 0 1rem;
			font-family: monospace;
			font-size: 0.75rem;
			letter-spacing: 0.16em;
			color: #4cffed;
		}

		h1 {
			margin: 0;
			font-size: clamp(2.4rem, 6vw, 4rem);
			letter-spacing: -0.04em;
		}

		p:not(.eyebrow) {
			margin: 1rem auto 2rem;
			max-width: 500px;
			color: #aaa4b9;
			line-height: 1.7;
		}
	</style>
</html>
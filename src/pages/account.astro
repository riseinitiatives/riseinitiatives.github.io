---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Account | RISE Initiatives"
			description="Manage your RISE account."
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="account-page">
				<p class="eyebrow">RISE // ACCOUNT</p>

				<h1>Account Settings</h1>

				<p class="intro">
					Manage your RISE identity and account.
				</p>

				<div class="account-card">
					<div class="account-row">
						<span>RISE User ID</span>
						<strong id="username">@loading...</strong>
					</div>

					<form id="username-form">
						<label for="new-username">Change RISE ID</label>

						<div class="username-input">
							<span>@</span>
							<input
								id="new-username"
								type="text"
								minlength="3"
								maxlength="20"
								placeholder="newusername"
								autocomplete="off"
								required
							/>
						</div>

						<button type="submit">
							Update RISE ID
						</button>
					</form>

					<div class="account-actions">
						<button id="switch-account" type="button">
							Switch Account
						</button>

						<button id="sign-out" type="button">
							Sign Out
						</button>
					</div>

					<p id="message"></p>
                    <div class="danger-zone">
                    <h2>Danger Zone</h2>

                    <p>
                        Deleting your account permanently removes your RISE account,
                        comments, and likes.
                    </p>

                    <button id="delete-account" type="button">
                        Delete Account
                    </button>
                </div>
				</div>
			</section>
		</main>

		<Footer />
	</body>

	<script>
		import { supabase } from '../lib/supabase';

		const usernameElement =
			document.querySelector('#username');

        const deleteAccountButton =
	        document.querySelector('#delete-account');    

		const form =
			document.querySelector('#username-form');

		const usernameInput =
			document.querySelector('#new-username');

		const switchAccountButton =
			document.querySelector('#switch-account');

		const signOutButton =
			document.querySelector('#sign-out');

		const message =
			document.querySelector('#message');

		let currentUser = null;

		async function loadAccount() {
            const {
                data: { user },
            } = await supabase.auth.getUser();

			const avatarUrl =
			user?.user_metadata?.avatar_url ??
			user?.user_metadata?.picture ??
			null;

			if (avatarUrl) {
				await supabase
					.from('profiles')
					.update({ avatar_url: avatarUrl })
					.eq('id', user.id);
			}

            if (!user) {
                window.location.href = '/login';
                return;
            }

            currentUser = user;

            const { data: profile, error } =
                await supabase
                    .from('profiles')
                    .select('username')
                    .eq('id', user.id)
                    .maybeSingle();

            if (error) {
                console.error('DELETE FUNCTION ERROR:', error);
                console.error('DELETE FUNCTION DATA:', data);
                console.error('DELETE FUNCTION CONTEXT:', error.context);

                let details = 'Unknown function error.';

                try {
                    if (error.context) {
                        const response = await error.context.clone();
                        const body = await response.text();

                        console.error(
                            'DELETE FUNCTION RESPONSE:',
                            body
                        );

                        details = body || details;
                    }
                } catch (debugError) {
                    console.error(
                        'Could not read function error response:',
                        debugError
                    );
                }

                deleteAccountButton.disabled = false;
                deleteAccountButton.textContent =
                    'Delete Account';

                message.textContent =
                    `DEBUG: ${details}`;

                return;
            }

            if (!profile) {
                window.location.href = '/setup-profile';
                return;
            }

            usernameElement.textContent =
                `@${profile.username}`;

            usernameInput.value =
                profile.username;

            message.textContent = '';
        }
        deleteAccountButton?.addEventListener(
            'click',
            async () => {
                const confirmed = window.confirm(
                    'Are you sure you want to permanently delete your RISE account? This cannot be undone.'
                );

                if (!confirmed) return;

                const secondConfirmation = window.confirm(
                    'Final confirmation: permanently delete this account?'
                );

                if (!secondConfirmation) return;

                deleteAccountButton.disabled = true;
                deleteAccountButton.textContent =
                    'Deleting account...';

                const {
                    data: { session },
                } = await supabase.auth.getSession();

                console.log('SESSION EXISTS:', !!session);
                console.log('USER EXISTS:', !!session?.user);    

                const { data, error } =
                    await supabase.functions.invoke(
                        'delete-account',
                        {
                            body: {
                                confirm: true,
                            },
                        }
                    );

                if (error) {
					console.error(
						'Delete account error:',
						error
					);

					deleteAccountButton.disabled = false;
					deleteAccountButton.textContent =
						'Delete Account';

					message.textContent =
						'Unable to delete your account. Please try again.';

					return;
				}

                if (!data?.success) {
                    console.error(
                        'Delete account response:',
                        data
                    );

                    deleteAccountButton.disabled = false;
                    deleteAccountButton.textContent =
                        'Delete Account';

                    message.textContent =
                        'Account deletion failed.';
                    return;
                }

                window.location.href = '/';
            }
        );

		form?.addEventListener(
			'submit',
			async (event) => {
				event.preventDefault();

				if (!currentUser) return;

				const username =
					usernameInput.value.trim();

				const usernamePattern =
					/^[A-Za-z][A-Za-z0-9_]{2,19}$/;

				if (!usernamePattern.test(username)) {
					message.textContent =
						'Use 3–20 characters: letters, numbers, and _ only. Start with a letter.';
					return;
				}

				message.textContent =
					'Updating your RISE ID...';

				const { data, error } =
					await supabase
						.from('profiles')
						.update({
							username,
						})
						.eq('id', currentUser.id)
						.select('username')
						.single();

				if (error) {
					console.error(error);

					if (error.code === '23505') {
						message.textContent =
							'That RISE ID is already taken.';
					} else if (
						error.message?.includes(
							'reserved_username'
						)
					) {
						message.textContent =
							'That RISE ID is reserved.';
					} else if (
						error.message?.includes(
							'invalid_username'
						)
					) {
						message.textContent =
							'Use 3–20 characters: letters, numbers, and _ only. Start with a letter.';
					} else {
						message.textContent =
							'Something went wrong. Please try again.';
					}

					return;
				}

				usernameElement.textContent =
					`@${data.username}`;

				usernameInput.value =
					data.username;

				message.textContent =
					'RISE ID updated successfully!';

				setTimeout(() => {
					message.textContent = '';
				}, 2500);
			}
		);

		switchAccountButton?.addEventListener(
			'click',
			async () => {
				const { error } =
					await supabase.auth.signOut({
						scope: 'local',
					});

				if (error) {
					console.error(
						'Switch account error:',
						error
					);

					message.textContent =
						'Unable to switch accounts.';

					return;
				}

				window.location.href = '/login';
			}
		);

		signOutButton?.addEventListener(
			'click',
			async () => {
				const { error } =
					await supabase.auth.signOut({
						scope: 'local',
					});

				if (error) {
					console.error(
						'Sign out error:',
						error
					);

					message.textContent =
						'Unable to sign out.';

					return;
				}

				window.location.href = '/';
			}
		);

		await supabase.auth.getSession();
        loadAccount();
	</script>

	<style>
		.account-page {
			width: min(560px, calc(100% - 2rem));
			margin: 6rem auto;
			text-align: center;
		}

		.eyebrow {
			margin: 0 0 1rem;
			font-family: monospace;
			font-size: 0.75rem;
			letter-spacing: 0.16em;
			color: #4cffed;
		}

		h1 {
			margin: 0;
			font-size: clamp(2.4rem, 6vw, 4rem);
			letter-spacing: -0.04em;
		}

		.intro {
			margin: 1rem auto 2.5rem;
			color: #aaa4b9;
			line-height: 1.7;
		}

		.account-card {
			padding: 1.5rem;
			border: 1px solid rgba(168, 85, 247, 0.2);
			border-radius: 16px;
			background: rgba(255, 255, 255, 0.035);
			text-align: left;
		}

		.account-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			padding-bottom: 1.25rem;
			margin-bottom: 1.5rem;
			border-bottom: 1px solid
				rgba(255, 255, 255, 0.08);
		}

		.account-row span {
			color: #aaa4b9;
			font-size: 0.85rem;
		}

		.account-row strong {
			color: #ffffff;
		}

		label {
			display: block;
			margin-bottom: 0.6rem;
			font-size: 0.85rem;
		}

		.username-input {
			display: flex;
			align-items: center;
			border: 1px solid
				rgba(255, 255, 255, 0.12);
			border-radius: 10px;
			background: rgba(255, 255, 255, 0.04);
			overflow: hidden;
		}

		.username-input span {
			padding-left: 1rem;
			color: #8e899b;
		}

		input {
			width: 100%;
			padding: 0.9rem;
			border: 0;
			outline: 0;
			background: transparent;
			color: white;
			font: inherit;
		}

		button {
			width: 100%;
			margin-top: 1rem;
			padding: 0.9rem;
			border: 0;
			border-radius: 10px;
			background: #a855f7;
			color: white;
			font: inherit;
			cursor: pointer;
			transition:
				background 0.2s ease,
				transform 0.2s ease;
		}

		button:hover {
			background: #c084fc;
			transform: translateY(-1px);
		}

		.account-actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.75rem;
			margin-top: 0.75rem;
		}

		.account-actions button {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid
				rgba(255, 255, 255, 0.1);
		}

		.account-actions button:hover {
			background: rgba(76, 255, 237, 0.06);
			border-color: rgba(76, 255, 237, 0.4);
		}

		#message {
			margin: 1rem 0 0;
			text-align: center;
			font-size: 0.85rem;
			color: #aaa4b9;
			min-height: 1.2em;
		}

		@media (max-width: 520px) {
			.account-actions {
				grid-template-columns: 1fr;
			}
		}
        .danger-zone {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 80, 100, 0.18);
        }

        .danger-zone h2 {
            margin: 0 0 0.5rem;
            font-size: 1rem;
            color: #ff7b8a;
        }

        .danger-zone p {
            margin: 0;
            color: #8e899b;
            font-size: 0.8rem;
            line-height: 1.6;
        }

        #delete-account {
            margin-top: 1rem;
            background: rgba(255, 80, 100, 0.08);
            border: 1px solid rgba(255, 80, 100, 0.3);
            color: #ff7b8a;
        }

        #delete-account:hover {
            background: rgba(255, 80, 100, 0.14);
            border-color: rgba(255, 80, 100, 0.55);
        }
	</style>
</html>
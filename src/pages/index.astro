		}

		:global(#home-comments-list .home-reply-cancel),
		:global(#home-comments-list .home-reply-submit) {
			padding: 7px 12px;
			border: 1px solid rgba(168, 85, 247, 0.3);
			border-radius: 999px;
			font: inherit;
			font-size: 0.8rem;
			cursor: pointer;
		}

		:global(#home-comments-list .home-reply-cancel) {
			background: transparent;
			color: rgba(255, 255, 255, 0.65);
		}

		:global(#home-comments-list .home-reply-submit) {
			background: rgba(168, 85, 247, 0.14);
			color: #c084fc;
		}

		:global(#home-comments-list .home-reply-submit:hover) {
			background: rgba(168, 85, 247, 0.25);
			color: #fff;
		}

		:global(#home-comments-list .home-reply-submit:disabled) {
			opacity: 0.5;
			cursor: wait;
		}

		:global(#home-comments-list .home-reply-status) {
			min-height: 1em;
			margin: 6px 0 0;

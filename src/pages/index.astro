			right: 0;
			display: block;
			box-sizing: border-box;
			min-width: 155px;
			padding: 5px;
			border: 1px solid rgba(168, 85, 247, 0.35);
			border-radius: 10px;
			background: #17111f;
			box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
		}

		/* Respect the hidden attribute despite the display rule above */
		:global(#home-comments-list .home-comment-menu[hidden]) {
			display: none !important;
		}

		/* Delete option */
		:global(#home-comments-list .home-comment-delete) {
			display: block;
			box-sizing: border-box;
			width: 100%;
			padding: 10px 12px;
			border: 0;
			border-radius: 7px;
			background: transparent;
			color: #ff8b9a;
			text-align: left;
			font: inherit;
			font-size: 0.85rem;
			cursor: pointer;
		}

		:global(#home-comments-list .home-comment-delete:hover) {
			background: rgba(255, 70, 100, 0.13);
			color: #ffb3bd;
		}

		:global(#home-comments-list .home-comment-delete:disabled) {
			opacity: 0.5;
			cursor: wait;
		}

		/* Mobile layout */
		@media (max-width: 600px) {
			:global(#home-comments-list .home-comment) {
				padding: 12px;
			}

			:global(#home-comments-list img.home-comment-avatar),
			:global(#home-comments-list .home-comment-avatar-fallback) {
				width: 38px !important;
				height: 38px !important;
				min-width: 38px;

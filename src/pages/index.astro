			width: 34px;
			height: 34px;
			padding: 0;
			border: 1px solid transparent;
			border-radius: 50%;
			background: transparent;
			color: rgba(255, 255, 255, 0.7);
			font: inherit;
			font-size: 23px;
			line-height: 1;
			cursor: pointer;
			transition: background 0.2s ease, color 0.2s ease;
		}

		:global(#home-comments-list .home-comment-menu-button:hover),
		:global(#home-comments-list .home-comment-menu-button[aria-expanded="true"]) {
			border-color: rgba(168, 85, 247, 0.3);
			background: rgba(168, 85, 247, 0.15);

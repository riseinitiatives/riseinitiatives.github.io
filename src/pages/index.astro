		:global(#home-comments-list .home-comment-reply-button) {
			padding: 5px 9px;
			border: 1px solid rgba(168, 85, 247, 0.25);
			border-radius: 999px;
			background: transparent;
			color: #c084fc;
			font: inherit;
			font-size: 0.8rem;
			cursor: pointer;
			transition: background 0.2s ease, color 0.2s ease;
		}

		:global(#home-comments-list .home-comment-reply-button:hover),
		:global(#home-comments-list .home-comment-reply-button[aria-expanded="true"]) {
			background: rgba(168, 85, 247, 0.14);
			color: #0bffe8;
		}

		/* Inline reply form */
		:global(#home-comments-list .home-reply-form) {
			margin: 12px 0 12px 53px;
		}

		:global(#home-comments-list .home-reply-form[hidden]) {
			display: none !important;
		}

		:global(#home-comments-list .home-reply-input) {
			display: block;
			box-sizing: border-box;
			width: 100%;
			min-height: 65px;
			padding: 10px 12px;
			border: 1px solid rgba(168, 85, 247, 0.25);
			border-radius: 10px;
			background: rgba(0, 0, 0, 0.22);

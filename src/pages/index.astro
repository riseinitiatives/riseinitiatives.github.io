		}

		:global(#home-comments-list .home-comment-reply .home-comment-avatar),
		:global(#home-comments-list .home-comment-reply .home-comment-avatar-fallback) {
			width: 32px !important;
			height: 32px !important;
			min-width: 32px;
			max-width: 32px !important;
			min-height: 32px;
			max-height: 32px !important;
			flex-basis: 32px;
		}

		:global(#home-comments-list .home-comment-reply .home-comment-body) {

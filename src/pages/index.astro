---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>RISE INITIATIVES</h1>
			<p class="tagline">Innovate, Protect, Serve.</p>
			<p>
				RISE Initiatives is an independent project focused on building practical technologies 
				that can help protect people, respond to emergencies, and make the world a safer place. 
				From intelligent robotics and AI-powered systems to innovative infrastructure, 
				RISE explores how technology can be applied to real-world challenges 
				and critical situations.
			</p>
			<img class="rise-image" src="/images/riser-1.png" alt="RISE prototype" />
			<p>
				RISE exists with a simple purpose: to turn ambitious ideas into technology 
				that solves real-world problems and protects lives. 
				Every project, prototype, and experiment is a step toward creating systems 
				that can make a meaningful difference when it matters most.
			</p>
			<img class="rise-image" src="/images/riser-2.png" alt="RISE prototype" />
			<p>Why RISE?</p>
			<p>		Technology should extend human capability — not replace it.</p>
			<ul>
				<li>Faster response in critical situations</li>
				<li>Reduced risk to human responders</li>
				<li>Continuous operation in hazardous environments</li>
				<li>Real-time sensing, monitoring, and decision support</li>
				<li>Access to areas that may be difficult or unsafe for humans</li>
				<li>Greater consistency during repetitive or high-risk operations</li>
			</ul>
			<img class="rise-image" src="/images/riser-3.png" alt="RISE prototype" />
			<p>
				RISE is currently in its early development stage, 
				with working prototypes and individual systems being tested and integrated.
				Each stage helps us validate the technology before moving towards more advanced 
				and capable systems.
			</p>
			<p>
				From individual prototypes → integrated systems → real-world capable technology.
			</p>
			<img class="rise-image" src="/images/riser-4.png" alt="RISE prototype" />
			<section class="development-path">
			<div class="path-info">
				<p class="eyebrow">RISE // DEVELOPMENT PATH</p>

				<h2>The Road Ahead</h2>

				<p>
				RISE is an evolving project. Every prototype, experiment, and
				integration moves the system one step closer to real-world capability.
				</p>

				<div class="status-panel">
				<span class="status-label">CURRENT PHASE</span>
				<strong>PROTOTYPING</strong>
				<span class="status-active">● ACTIVE DEVELOPMENT</span>
				</div>
			</div>

			<div class="path-map">

				<svg
				class="development-route"
				viewBox="0 0 500 900"
				xmlns="http://www.w3.org/2000/svg"
				aria-label="RISE development path"
				>
				<path
					class="route-base"
					d="M250 40
					C250 140 100 140 100 250
					C100 360 400 340 400 460
					C400 580 150 560 150 680
					C150 770 250 770 250 860"
				/>

				<path
					class="route-glow"
					d="M250 40
					C250 140 100 140 100 250
					C100 360 400 340 400 460
					C400 580 150 560 150 680
					C150 770 250 770 250 860"
				/>

				<circle class="milestone" cx="250" cy="40" r="7" />
				<circle class="milestone" cx="100" cy="250" r="7" />
				<circle class="milestone" cx="400" cy="460" r="7" />
				<circle class="milestone active" cx="150" cy="680" r="9" />
				<circle class="milestone future" cx="250" cy="860" r="7" />

				<!-- PIXEL ROVER -->
				<g class="pixel-rover" transform="translate(118 645)">
					<rect x="8" y="10" width="42" height="20" />
					<rect x="14" y="4" width="28" height="8" />
					<rect x="20" y="12" width="8" height="7" class="rover-screen" />
					<rect x="32" y="12" width="6" height="7" class="rover-light" />

					<rect x="2" y="28" width="14" height="7" />
					<rect x="42" y="28" width="14" height="7" />

					<rect x="8" y="35" width="9" height="9" class="rover-wheel" />
					<rect x="39" y="35" width="9" height="9" class="rover-wheel" />
				</g>
				</svg>

				<div class="milestone-label concept">
				<span>2022</span>
				<strong>THE SPARK</strong>
				</div>

				<div class="milestone-label prototype">
				<span>2023</span>
				<strong>FIRST PROTOTYPES</strong>
				</div>

				<div class="milestone-label intelligence">
				<span>2024–25</span>
				<strong>IDEA DEVELOPMENT</strong>
				</div>

				<div class="milestone-label current">
				<span>2026</span>
				<strong>AI, ROBOTICS AND WORKING SYSTEMS</strong>
				</div>

				<div class="milestone-label future">
				<span>NEXT</span>
				<strong>INTEGRATION</strong>
				</div>

			</div>
			</section>

			<section class="home-comments home-comments-locked">
				<div class="home-comments-content" inert aria-hidden="true">
					<p class="comments-eyebrow">RISE // COMMUNITY</p>
					<h2>Share Your Thoughts</h2>
					<p class="comments-intro">
						Have an idea, question, or thought about RISE?
						Join the conversation.
					</p>

					<div id="home-comments-list">
						Community discussions are currently locked.
					</div>

					<div class="home-comment-form">
						<textarea
							placeholder="Write a comment..."
							rows="4"
							disabled
						></textarea>

						<button type="button" disabled>
							Post Comment
						</button>
					</div>
				</div>

				<div class="home-lock-overlay" role="status">
					<div class="home-lock-strip">
						<span>🔒 LOCKED</span>
					</div>

					<div class="home-lock-message">
						<p class="comments-eyebrow">RISE // COMMUNITY</p>
						<h2>Community Under Development</h2>
						<p>
							A space for builders, creators, and curious minds.
							The RISE Community will open when it is ready.
						</p>
					</div>
				</div>
			</section>

			<div class="share-link">
				<button id="copy-link" type="button">🔗 Copy Link</button>
			</div>
		</main>
		<Footer />
	</body>
	<style>
		/* ================================
   	
		================================ */

		.development-path {
		margin-top: 8rem;
		padding: 5rem 0 7rem;

		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;

		align-items: center;
		}

		/* LEFT INFORMATION */

		.path-info {
		padding-right: 2rem;
		}

		.path-info .eyebrow {
		margin: 0 0 1rem;

		font-family: monospace;
		font-size: 0.8rem;
		letter-spacing: 0.15em;

		color: #4cffed;
		}

		.path-info h2 {
		margin: 0 0 1.5rem;

		font-size: 2.8rem;
		line-height: 1.1;

		color: #f5f3ff;
		}

		.path-info > p:not(.eyebrow) {
		color: #c8c3d9;
		line-height: 1.8;
		}

		/* STATUS PANEL */

		.status-panel {
		margin-top: 2rem;
		padding: 1.2rem 1.4rem;

		border-left: 2px solid #bb71ff;

		background: rgba(168, 85, 247, 0.06);

		box-shadow:
			0 0 20px rgba(168, 85, 247, 0.08),
			inset 0 0 20px rgba(168, 85, 247, 0.03);

		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		}

		.status-label {
		font-family: monospace;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: #aaa4b9;
		}

		.status-panel strong {
		font-family: monospace;
		font-size: 1.2rem;
		color: #ffffff;
		letter-spacing: 0.08em;
		}

		.status-active {
		font-family: monospace;
		font-size: 0.72rem;
		color: #4cffed;
		}


		/* ================================
		PATH MAP
		================================ */

		.path-map {
		position: relative;

		width: 100%;
		max-width: 500px;

		height: 900px;

		margin: 0 auto;
		}


		/* SVG */

		.development-route {
		width: 100%;
		height: 100%;

		overflow: visible;
		}


		/* DARK ROAD */

		.route-base {
		fill: none;

		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 28;

		stroke-linecap: round;
		stroke-linejoin: round;
		}


		/* GLOWING ROAD */

		.route-glow {
		fill: none;

		stroke: #8b5cf6;
		stroke-width: 3;

		stroke-linecap: round;
		stroke-linejoin: round;

		filter: drop-shadow(0 0 6px rgba(139, 92, 246, 0.8));
		}


		/* MILESTONES */

		.milestone {
		fill: #0b0810;
		stroke: #bb71ff;
		stroke-width: 3;

		filter: drop-shadow(0 0 5px rgba(187, 113, 255, 0.7));
		}

		.milestone.active {
		fill: #4cffed;
		stroke: #ffffff;
		stroke-width: 3;

		filter:
			drop-shadow(0 0 5px #4cffed)
			drop-shadow(0 0 12px rgba(76, 255, 237, 0.6));
		}

		.milestone.future {
		fill: #0b0810;
		stroke: rgba(255, 255, 255, 0.35);
		filter: none;
		}


		/* ================================
		PIXEL ROVER
		================================ */

		.pixel-rover rect {
		fill: #f5f3ff;
		}

		.pixel-rover .rover-screen {
		fill: #0b0810;
		}

		.pixel-rover .rover-light {
		fill: #4cffed;
		}

		.pixel-rover .rover-wheel {
		fill: #8b5cf6;
		}


		/* ================================
		MILESTONE LABELS
		================================ */

		.milestone-label {
		position: absolute;

		display: flex;
		flex-direction: column;

		gap: 0.2rem;

		font-family: monospace;

		padding: 0.7rem 0.9rem;

		background: rgba(11, 8, 16, 0.82);
		border: 1px solid rgba(187, 113, 255, 0.25);

		backdrop-filter: blur(8px);

		box-shadow:
			0 0 15px rgba(168, 85, 247, 0.08);
		}

		.milestone-label span {
		font-size: 0.7rem;
		color: #4cffed;
		letter-spacing: 0.08em;
		}

		.milestone-label strong {
		font-size: 0.8rem;
		color: #f5f3ff;
		letter-spacing: 0.04em;
		}


		/* INDIVIDUAL POSITIONS */

		.milestone-label.concept {
		top: 2%;
		right: -5%;
		}

		.milestone-label.prototype {
		top: 25%;
		left: -5%;
		}

		.milestone-label.intelligence {
		top: 47%;
		right: -8%;
		}

		.milestone-label.current {
		top: 69%;
		left: -10%;

		border-color: rgba(76, 255, 237, 0.45);

		box-shadow:
			0 0 15px rgba(76, 255, 237, 0.12);
		}

		.milestone-label.future {
		bottom: 0;
		right: -5%;

		opacity: 0.55;
		}


		/* MOBILE */

		@media (max-width: 800px) {
		.development-path {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.path-info {
			padding-right: 0;
		}

		.path-map {
			height: 750px;
			max-width: 420px;
		}

		.milestone-label {
			transform: scale(0.9);
		}
		}
		.share-link {
			margin: 2rem 0;
			text-align: center;
		}

		.share-link button {
			padding: 0.7rem 1.2rem;
			border: 1px solid rgba(168, 85, 247, 0.45);
			border-radius: 999px;
			background: rgba(168, 85, 247, 0.08);
			color: rgb(192, 132, 252);
			font: inherit;
			font-weight: 600;
			cursor: pointer;
			transition:
				background 0.2s ease,
				border-color 0.2s ease,
				transform 0.2s ease;
		}

		.share-link button:hover {
			background: rgba(168, 85, 247, 0.16);
			border-color: rgba(192, 132, 252, 0.7);
			transform: translateY(-1px);
		}
		.tagline {
			margin: -0.2rem 0 1.5rem;
			font-family: Georgia, 'Times New Roman', serif;
			font-size: 1.15rem;
			font-style: italic;
			font-weight: 500;
			letter-spacing: 0.08em;
			color: rgba(192, 132, 252, 0.9);
		}

		.home-comments {
			max-width: 850px;
			margin: 5rem auto 3rem;
			padding: 30px;
			border: 1px solid rgba(168, 85, 247, 0.2);
			border-radius: 18px;
			background: linear-gradient(
				135deg,
				rgba(168, 85, 247, 0.055),
				rgba(255, 255, 255, 0.012)
			);
		}

		.comments-eyebrow {
			margin: 0 0 12px;
			color: #0bffe8;
			font: 800 0.7rem monospace;
			letter-spacing: 0.16em;
		}

		.home-comments h2 {
			margin: 0 0 10px;
			color: #fff;
			font-size: 1.8rem;
		}

		.comments-intro {
			margin-bottom: 24px;
			color: rgba(255, 255, 255, 0.6);
			line-height: 1.7;
		}

		.home-comment {
			padding: 15px 5px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		}

		.home-comment-author {
			margin-bottom: 8px;
			color: #c084fc;
			font-weight: 700;
		}

		.home-comment-time {
			margin-left: 8px;
			color: rgba(255, 255, 255, 0.35);
			font-size: 0.8rem;
			font-weight: 400;
		}

		.home-comment-body {
			color: rgba(255, 255, 255, 0.75);
			line-height: 1.6;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}

		.home-comment-form {
			margin-top: 25px;
		}

		#home-comment-input {
			box-sizing: border-box;
			width: 100%;
			padding: 14px 16px;
			border: 1px solid rgba(168, 85, 247, 0.2);
			border-radius: 12px;
			background: rgba(255, 255, 255, 0.025);
			color: #fff;
			font: inherit;
			line-height: 1.6;
			resize: vertical;
			outline: none;
		}

		#home-comment-input::placeholder {
			color: rgba(255, 255, 255, 0.35);
		}

		#home-comment-input:focus {
			border-color: rgba(192, 132, 252, 0.55);
			box-shadow: 0 0 18px rgba(168, 85, 247, 0.08);
		}

		#home-post-comment {
			margin-top: 10px;
			padding: 9px 16px;
			border: 1px solid rgba(168, 85, 247, 0.35);
			border-radius: 10px;
			background: rgba(168, 85, 247, 0.1);
			color: #c084fc;
			font: inherit;
			font-weight: 700;
			cursor: pointer;
			transition: 0.2s ease;
		}

		#home-post-comment:hover {
			background: rgba(168, 85, 247, 0.18);
			border-color: rgba(192, 132, 252, 0.65);
			color: #fff;
			transform: translateY(-1px);
		}

		#home-comment-status {
			min-height: 1.3em;
			color: #0bffe8;
			font-size: 0.85rem;
		}

		@media (max-width: 600px) {
			.home-comments {
				padding: 22px;
				margin-top: 3rem;
			}
		}


		/* HOMEPAGE COMMENTS SECTION */
		.home-comments {
			max-width: 850px;
			margin: 7rem auto 5rem;
			padding: 2.5rem;
			position: relative;

			border: 1px solid rgba(168, 85, 247, 0.25);
			border-radius: 20px;

			background:
				linear-gradient(
					145deg,
					rgba(168, 85, 247, 0.09),
					rgba(11, 8, 16, 0.96) 55%,
					rgba(11, 255, 232, 0.025)
				);

			box-shadow:
				0 0 35px rgba(168, 85, 247, 0.07),
				inset 0 0 25px rgba(168, 85, 247, 0.025);
		}

		.home-comments::before {
			content: "";
			position: absolute;
			top: 0;
			left: 2.5rem;
			right: 2.5rem;
			height: 1px;
			background: linear-gradient(
				90deg,
				transparent,
				#a855f7,
				#0bffe8,
				transparent
			);
		}

		.home-comments .comments-eyebrow {
			color: #0bffe8;
			font: 800 0.72rem monospace;
			letter-spacing: 0.18em;
			margin-bottom: 0.8rem;
		}

		.home-comments h2 {
			color: #fff;
			font-size: clamp(1.7rem, 4vw, 2.3rem);
			margin: 0 0 0.7rem;
		}

		.home-comments .comments-intro {
			color: rgba(255, 255, 255, 0.58);
			line-height: 1.7;
			margin-bottom: 2rem;
		}

		/* COMMENT LIST */
		#home-comments-list {
			display: flex;
			flex-direction: column;
			gap: 0.8rem;
		}

		.home-comment {
			padding: 1.1rem 1.2rem;
			border: 1px solid rgba(168, 85, 247, 0.12);
			border-radius: 12px;
			background: rgba(255, 255, 255, 0.025);
			transition:
				border-color 0.2s ease,
				background 0.2s ease,
				transform 0.2s ease;
		}

		.home-comment:hover {
			border-color: rgba(168, 85, 247, 0.35);
			background: rgba(168, 85, 247, 0.045);
			transform: translateY(-2px);
		}

		.home-comment-author {
			color: #c084fc;
			font-size: 0.95rem;
			font-weight: 700;
			margin-bottom: 0.65rem;
		}

		.home-comment-time {
			color: rgba(255, 255, 255, 0.35);
			font-size: 0.78rem;
			font-weight: 400;
		}

		.home-comment-body {
			color: rgba(255, 255, 255, 0.78);
			line-height: 1.7;
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}

		/* COMMENT FORM */
		.home-comment-form {
			margin-top: 2rem;
			padding-top: 1.5rem;
			border-top: 1px solid rgba(168, 85, 247, 0.16);
		}

		#home-comment-input {
			width: 100%;
			box-sizing: border-box;
			padding: 1rem 1.1rem;
			border: 1px solid rgba(168, 85, 247, 0.25);
			border-radius: 12px;
			background: rgba(0, 0, 0, 0.22);
			color: #fff;
			font: inherit;
			line-height: 1.6;
			resize: vertical;
			outline: none;
			transition:
				border-color 0.2s ease,
				box-shadow 0.2s ease;
		}

		#home-comment-input::placeholder {
			color: rgba(255, 255, 255, 0.35);
		}

		#home-comment-input:focus {
			border-color: #a855f7;
			box-shadow: 0 0 18px rgba(168, 85, 247, 0.13);
		}

		#home-post-comment {
			margin-top: 1rem;
			padding: 0.75rem 1.3rem;
			border: 1px solid rgba(168, 85, 247, 0.5);
			border-radius: 999px;
			background: rgba(168, 85, 247, 0.12);
			color: #c084fc;
			font: inherit;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		#home-post-comment:hover {
			border-color: #0bffe8;
			background: rgba(168, 85, 247, 0.2);
			color: #fff;
			box-shadow: 0 0 18px rgba(168, 85, 247, 0.15);
			transform: translateY(-2px);
		}

		#home-post-comment:disabled {
			opacity: 0.5;
			cursor: wait;
			transform: none;
		}

		#home-comment-status {
			min-height: 1.3em;
			margin-top: 0.8rem;
			color: #0bffe8;
			font-size: 0.85rem;
		}

		/* MOBILE */
		@media (max-width: 600px) {
			.home-comments {
				margin: 4rem 0 3rem;
				padding: 1.4rem;
				border-radius: 15px;
			}

			.home-comments::before {
				left: 1.4rem;
				right: 1.4rem;
			}

			.home-comment {
				padding: 1rem;
			}
		}

				/* COMMENT CARD HEADER */
		.home-comment-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 0.9rem;
		}

		.home-comment-user {
			display: flex;
			align-items: center;
			gap: 0.8rem;
			min-width: 0;
		}

		.home-comment-avatar {
			width: 42px;
			height: 42px;
			flex: 0 0 42px;
			border-radius: 50%;
			object-fit: cover;
			border: 1px solid rgba(168, 85, 247, 0.45);
			background: rgba(168, 85, 247, 0.12);
		}

		.home-comment-avatar-fallback {
			display: grid;
			place-items: center;
			font-size: 1.2rem;
		}

		.home-comment-author {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			margin: 0;
			min-width: 0;
		}

		.home-comment-author strong {
			color: #c084fc;
			font-size: 0.92rem;
			overflow-wrap: anywhere;
		}

		.home-comment-time {
			margin: 0;
			font-size: 0.75rem;
		}

		/* DISTINCT COMMENT CARDS */
		#home-comments-list {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
		}

		.home-comment {
			padding: 1.1rem;
			border: 1px solid rgba(168, 85, 247, 0.2);
			border-radius: 14px;

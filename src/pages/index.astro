---
import Community from '../components/Community.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>RISE INITIATIVES</h1>
			<p>
				RISE Initiatives is an independent project focused on building practical technologies 
				that can help protect people, respond to emergencies, and make the world a safer place. 
				From intelligent robotics and AI-powered systems to innovative infrastructure, 
				RISE explores how technology can be applied to real-world challenges 
				and critical situations.
			</p>
			<img class="rise-image" src="/images/riser-1.png" alt="RISE prototype" />
			<p>
				RISE exists with a simple purpose: to turn ambitious ideas into technology 
				that solves real-world problems and protects lives. 
				Every project, prototype, and experiment is a step toward creating systems 
				that can make a meaningful difference when it matters most.
			</p>
			<img class="rise-image" src="/images/riser-2.png" alt="RISE prototype" />
			<p>Why RISE?</p>
			<p>		Technology should extend human capability — not replace it.</p>
			<ul>
				<li>Faster response in critical situations</li>
				<li>Reduced risk to human responders</li>
				<li>Continuous operation in hazardous environments</li>
				<li>Real-time sensing, monitoring, and decision support</li>
				<li>Access to areas that may be difficult or unsafe for humans</li>
				<li>Greater consistency during repetitive or high-risk operations</li>
			</ul>
			<img class="rise-image" src="/images/riser-3.png" alt="RISE prototype" />
			<p>
				RISE is currently in its early development stage, 
				with working prototypes and individual systems being tested and integrated.
				Each stage helps us validate the technology before moving toward more advanced 
				and capable systems.
			</p>
			<p>
				From individual prototypes → integrated systems → real-world capable technology.
			</p>
			<img class="rise-image" src="/images/riser-4.png" alt="RISE prototype" />
			<section class="development-path">
			<div class="path-info">
				<p class="eyebrow">RISE // DEVELOPMENT PATH</p>

				<h2>The Road Ahead</h2>

				<p>
				RISE is an evolving project. Every prototype, experiment, and
				integration moves the system one step closer to real-world capability.
				</p>

				<div class="status-panel">
				<span class="status-label">CURRENT PHASE</span>
				<strong>PROTOTYPING</strong>
				<span class="status-active">● ACTIVE DEVELOPMENT</span>
				</div>
			</div>

			<div class="path-map">

				<svg
				class="development-route"
				viewBox="0 0 500 900"
				xmlns="http://www.w3.org/2000/svg"
				aria-label="RISE development path"
				>
				<path
					class="route-base"
					d="M250 40
					C250 140 100 140 100 250
					C100 360 400 340 400 460
					C400 580 150 560 150 680
					C150 770 250 770 250 860"
				/>

				<path
					class="route-glow"
					d="M250 40
					C250 140 100 140 100 250
					C100 360 400 340 400 460
					C400 580 150 560 150 680
					C150 770 250 770 250 860"
				/>

				<circle class="milestone" cx="250" cy="40" r="7" />
				<circle class="milestone" cx="100" cy="250" r="7" />
				<circle class="milestone" cx="400" cy="460" r="7" />
				<circle class="milestone active" cx="150" cy="680" r="9" />
				<circle class="milestone future" cx="250" cy="860" r="7" />

				<!-- PIXEL ROVER -->
				<g class="pixel-rover" transform="translate(118 645)">
					<rect x="8" y="10" width="42" height="20" />
					<rect x="14" y="4" width="28" height="8" />
					<rect x="20" y="12" width="8" height="7" class="rover-screen" />
					<rect x="32" y="12" width="6" height="7" class="rover-light" />

					<rect x="2" y="28" width="14" height="7" />
					<rect x="42" y="28" width="14" height="7" />

					<rect x="8" y="35" width="9" height="9" class="rover-wheel" />
					<rect x="39" y="35" width="9" height="9" class="rover-wheel" />
				</g>
				</svg>

				<div class="milestone-label concept">
				<span>2022</span>
				<strong>THE SPARK</strong>
				</div>

				<div class="milestone-label prototype">
				<span>2023</span>
				<strong>FIRST PROTOTYPES</strong>
				</div>

				<div class="milestone-label intelligence">
				<span>2024–25</span>
				<strong>IDEA DEVELOPMENT</strong>
				</div>

				<div class="milestone-label current">
				<span>2026</span>
				<strong>AI, ROBOTICS AND WORKING SYSTEMS</strong>
				</div>

				<div class="milestone-label future">
				<span>NEXT</span>
				<strong>INTEGRATION</strong>
				</div>

			</div>
			</section>
			<Community postId="home" />
		</main>
		<Footer />
	</body>
	<style>
		/* ================================
   	
		================================ */

		.development-path {
		margin-top: 8rem;
		padding: 5rem 0 7rem;

		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;

		align-items: center;
		}

		/* LEFT INFORMATION */

		.path-info {
		padding-right: 2rem;
		}

		.path-info .eyebrow {
		margin: 0 0 1rem;

		font-family: monospace;
		font-size: 0.8rem;
		letter-spacing: 0.15em;

		color: #4cffed;
		}

		.path-info h2 {
		margin: 0 0 1.5rem;

		font-size: 2.8rem;
		line-height: 1.1;

		color: #f5f3ff;
		}

		.path-info > p:not(.eyebrow) {
		color: #c8c3d9;
		line-height: 1.8;
		}

		/* STATUS PANEL */

		.status-panel {
		margin-top: 2rem;
		padding: 1.2rem 1.4rem;

		border-left: 2px solid #bb71ff;

		background: rgba(168, 85, 247, 0.06);

		box-shadow:
			0 0 20px rgba(168, 85, 247, 0.08),
			inset 0 0 20px rgba(168, 85, 247, 0.03);

		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		}

		.status-label {
		font-family: monospace;
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		color: #aaa4b9;
		}

		.status-panel strong {
		font-family: monospace;
		font-size: 1.2rem;
		color: #ffffff;
		letter-spacing: 0.08em;
		}

		.status-active {
		font-family: monospace;
		font-size: 0.72rem;
		color: #4cffed;
		}


		/* ================================
		PATH MAP
		================================ */

		.path-map {
		position: relative;

		width: 100%;
		max-width: 500px;

		height: 900px;

		margin: 0 auto;
		}


		/* SVG */

		.development-route {
		width: 100%;
		height: 100%;

		overflow: visible;
		}


		/* DARK ROAD */

		.route-base {
		fill: none;

		stroke: rgba(255, 255, 255, 0.08);
		stroke-width: 28;

		stroke-linecap: round;
		stroke-linejoin: round;
		}


		/* GLOWING ROAD */

		.route-glow {
		fill: none;

		stroke: #8b5cf6;
		stroke-width: 3;

		stroke-linecap: round;
		stroke-linejoin: round;

		filter: drop-shadow(0 0 6px rgba(139, 92, 246, 0.8));
		}


		/* MILESTONES */

		.milestone {
		fill: #0b0810;
		stroke: #bb71ff;
		stroke-width: 3;

		filter: drop-shadow(0 0 5px rgba(187, 113, 255, 0.7));
		}

		.milestone.active {
		fill: #4cffed;
		stroke: #ffffff;
		stroke-width: 3;

		filter:
			drop-shadow(0 0 5px #4cffed)
			drop-shadow(0 0 12px rgba(76, 255, 237, 0.6));
		}

		.milestone.future {
		fill: #0b0810;
		stroke: rgba(255, 255, 255, 0.35);
		filter: none;
		}


		/* ================================
		PIXEL ROVER
		================================ */

		.pixel-rover rect {
		fill: #f5f3ff;
		}

		.pixel-rover .rover-screen {
		fill: #0b0810;
		}

		.pixel-rover .rover-light {
		fill: #4cffed;
		}

		.pixel-rover .rover-wheel {
		fill: #8b5cf6;
		}


		/* ================================
		MILESTONE LABELS
		================================ */

		.milestone-label {
		position: absolute;

		display: flex;
		flex-direction: column;

		gap: 0.2rem;

		font-family: monospace;

		padding: 0.7rem 0.9rem;

		background: rgba(11, 8, 16, 0.82);
		border: 1px solid rgba(187, 113, 255, 0.25);

		backdrop-filter: blur(8px);

		box-shadow:
			0 0 15px rgba(168, 85, 247, 0.08);
		}

		.milestone-label span {
		font-size: 0.7rem;
		color: #4cffed;
		letter-spacing: 0.08em;
		}

		.milestone-label strong {
		font-size: 0.8rem;
		color: #f5f3ff;
		letter-spacing: 0.04em;
		}


		/* INDIVIDUAL POSITIONS */

		.milestone-label.concept {
		top: 2%;
		right: -5%;
		}

		.milestone-label.prototype {
		top: 25%;
		left: -5%;
		}

		.milestone-label.intelligence {
		top: 47%;
		right: -8%;
		}

		.milestone-label.current {
		top: 69%;
		left: -10%;

		border-color: rgba(76, 255, 237, 0.45);

		box-shadow:
			0 0 15px rgba(76, 255, 237, 0.12);
		}

		.milestone-label.future {
		bottom: 0;
		right: -5%;

		opacity: 0.55;
		}


		/* MOBILE */

		@media (max-width: 800px) {
		.development-path {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.path-info {
			padding-right: 0;
		}

		.path-map {
			height: 750px;
			max-width: 420px;
		}

		.milestone-label {
			transform: scale(0.9);
		}
		}
	</style>
</html>

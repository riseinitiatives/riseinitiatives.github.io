			font-size: 0.9rem;
		}

		@media (max-width: 600px) {
			:global(#home-comments-list .home-comment-actions),
			:global(#home-comments-list .home-reply-form) {
				margin-left: 0;
			}

			:global(#home-comments-list .home-comment-replies) {
				margin-left: 8px;
				padding-left: 9px;
			}

			:global(#home-comments-list .home-comment-reply .home-comment-body) {
				padding-left: 0;
			}
		}

		:global(#home-comments-list .home-comment-header) {
			flex-wrap: wrap;
		}

		:global(#home-comments-list .home-comment-hide-button) {
			padding: 5px 9px;
			border: 1px solid rgba(168, 85, 247, 0.25);
			border-radius: 999px;
			background: transparent;
			color: #c084fc;
			font: inherit;
			font-size: 0.78rem;
			cursor: pointer;
		}

		:global(#home-comments-list .home-comment-hide-button:hover) {
			background: rgba(168, 85, 247, 0.14);
			color: #0bffe8;
		}

		:global(#home-comments-list .home-comment-content[hidden]) {
			display: none !important;
		}


	</style>
</html>

<script>
    import { supabase } from '../lib/supabase';

    // Replace this with the UUID of the dedicated homepage anchor post.
    const HOME_POST_ID = '082b06f6-c759-4f81-ab05-3e7e5e7253cf';

    const list = document.querySelector<HTMLElement>(
        '#home-comments-list'
    );
    const input = document.querySelector<HTMLTextAreaElement>(
        '#home-comment-input'
    );
    const postButton = document.querySelector<HTMLButtonElement>(
        '#home-post-comment'
    );
    const status = document.querySelector<HTMLElement>(
        '#home-comment-status'
    );

    const escapeHTML = (value: string) =>
        value.replace(/[&<>"']/g, (char) => {
            const entities: Record<string, string> = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;',
            };
            return entities[char];
        });

    async function loadHomeComments() {
		if (!list) return;

		const { data: comments, error } = await supabase
			.from('comments')
			.select('id, parent_id, user_id, display_name, body, created_at')
			.eq('post_id', HOME_POST_ID)
			.order('created_at', { ascending: true });

		if (error) {
			console.error('Homepage comments error:', error);
			list.textContent = 'Unable to load comments.';
			return;
		}

		if (!comments?.length) {
			list.textContent =
				'No comments yet. Be the first to share a thought!';
			return;
		}

		

		const allComments = comments || []; 	
		const userIds = [...new Set(allComments.map((comment) => comment.user_id))];

		const [
			{ data: profiles, error: profilesError },
			{ data: { user } }
		] = await Promise.all([
			supabase
				.from('profiles')
				.select('id, username, avatar_url')
				.in('id', userIds),
			supabase.auth.getUser()
		]);

		if (profilesError) {
			console.error('Homepage profile loading error:', profilesError);
		}

		const profileMap = new Map(
			(profiles || []).map((profile) => [profile.id, profile])
		);

		const formatDate = (createdAt: string) =>
			new Date(createdAt).toLocaleDateString('en-IN', {
				day: 'numeric',
				month: 'short',
				year: 'numeric'
			});

		const commentsByParent = new Map<string | null, any[]>();

		for (const comment of allComments) {
			const parentId = comment.parent_id ?? null;
			const siblings = commentsByParent.get(parentId) || [];

			siblings.push(comment);
			commentsByParent.set(parentId, siblings);
		}	

		const renderComment = (comment: any, isReply = false) => {
			const profile = profileMap.get(comment.user_id);
			const username =
				profile?.username || comment.display_name || 'RISE User';
			const isOwner = user?.id === comment.user_id;

			const avatar = profile?.avatar_url
				? `<img
					class="home-comment-avatar"
					src="${escapeHTML(profile.avatar_url)}"
					alt=""
					loading="lazy"
				/>`
				: `<div class="home-comment-avatar home-comment-avatar-fallback"
						aria-hidden="true">👤</div>`;

			return `
				<article class="home-comment ${isReply ? 'home-comment-reply' : ''}">
					<div class="home-comment-header">
						<div class="home-comment-user">
							${avatar}
							<div class="home-comment-author">
								<strong>@${escapeHTML(username)}</strong>
								<span class="home-comment-time">
									${escapeHTML(formatDate(comment.created_at))}
								</span>
							</div>
						</div>

						<button
							class="home-comment-hide-button"
							type="button"
							aria-expanded="true"
						>
							Hide
						</button>

						${isOwner ? `
							<div class="home-comment-menu-wrap">
								<button
									class="home-comment-menu-button"
									type="button"
									aria-label="Comment options"
									aria-expanded="false"
									aria-haspopup="true"
								>⋮</button>

								<div class="home-comment-menu" hidden>
									<button
										class="home-comment-delete"
										type="button"
										data-comment-id="${escapeHTML(comment.id)}"
									>Delete ${isReply ? 'reply' : 'comment'}</button>
								</div>
							</div>
						` : ''}
					</div>

				<div class="home-comment-content">

					<div class="home-comment-body">${escapeHTML(comment.body)}</div>

					

					${`
						<div class="home-comment-actions">
							<button
								class="home-comment-reply-button"
								type="button"
								data-parent-id="${escapeHTML(comment.id)}"
								aria-expanded="false"
							>↳ Reply</button>
						</div>

						<form
							class="home-reply-form"
							data-parent-id="${escapeHTML(comment.id)}"
							hidden
						>
							<textarea
								class="home-reply-input"
								rows="2"
								maxlength="2000"
								placeholder="Write a reply..."
								aria-label="Write a reply"
								required
							></textarea>
							<div class="home-reply-form-actions">
								<button class="home-reply-cancel" type="button">Cancel</button>
								<button class="home-reply-submit" type="submit">Post Reply</button>
							</div>
							<p class="home-reply-status" aria-live="polite"></p>
						</form>

						${
							(commentsByParent.get(comment.id) || []).length
								? `
									<div class="home-comment-replies">
										${(commentsByParent.get(comment.id) || [])
											.map((reply) => renderComment(reply, true))
											.join('')}
									</div>
								`
								: ''
						}
					`}
				</div>	
				</article>
			`;
		};

		list.innerHTML = (commentsByParent.get(null) || [])
			.map((comment) => renderComment(comment))
			.join('');
	}

	list?.addEventListener('click', async (event) => {
		const target = event.target;

		if (!(target instanceof HTMLElement)) return;

		// Hide or show an individual comment and its replies
		const hideButton = target.closest<HTMLButtonElement>(
			'.home-comment-hide-button'
		);

		if (hideButton) {
			const comment = hideButton.closest<HTMLElement>('.home-comment');
			const content = comment?.querySelector<HTMLElement>(
				':scope > .home-comment-content'
			);

			if (!content) return;

			const isExpanded = hideButton.getAttribute('aria-expanded') === 'true';

			content.hidden = isExpanded;
			hideButton.setAttribute('aria-expanded', String(!isExpanded));
			hideButton.textContent = isExpanded ? 'Show' : 'Hide';

			return;
		}

		// Toggle the three-dot menu
		const menuButton = target.closest<HTMLButtonElement>(
			'.home-comment-menu-button'
		);

		if (menuButton) {
			const wrapper = menuButton.closest('.home-comment-menu-wrap');
			const menu = wrapper?.querySelector<HTMLElement>(
				'.home-comment-menu'
			);

			if (!menu) return;

			const isOpening = menu.hidden;

			// Close any other open comment menus
			list.querySelectorAll<HTMLElement>('.home-comment-menu').forEach(
				(otherMenu) => {
					otherMenu.hidden = true;
				}
			);

			list.querySelectorAll<HTMLButtonElement>(
				'.home-comment-menu-button'
			).forEach((button) => {
				button.setAttribute('aria-expanded', 'false');
			});

			menu.hidden = !isOpening;
			menuButton.setAttribute('aria-expanded', String(isOpening));
			return;
		}

		// Delete an owned comment
		const deleteButton = target.closest<HTMLButtonElement>(
			'.home-comment-delete'
		);

		if (deleteButton) {
			const commentId = deleteButton.dataset.commentId;
			if (!commentId || !status) return;

			const confirmed = window.confirm(
				'Are you sure you want to delete this comment?'
			);

			if (!confirmed) return;

			deleteButton.disabled = true;
			status.textContent = 'Deleting comment...';

			const { data: { user } } = await supabase.auth.getUser();

			if (!user) {
				status.textContent = 'Please log in to delete your comment.';
				return;
			}

			const { error } = await supabase
				.from('comments')
				.delete()
				.eq('id', commentId)
				.eq('user_id', user.id)
				.eq('post_id', HOME_POST_ID);

			if (error) {
				console.error('Comment deletion error:', error);
				status.textContent = 'Could not delete the comment.';
				deleteButton.disabled = false;
				return;
			}

			status.textContent = 'Comment deleted.';
			await loadHomeComments();
		}

				// Open or close a reply form
		const replyButton = target.closest<HTMLButtonElement>(
			'.home-comment-reply-button'
		);

		if (replyButton) {
			const comment = replyButton.closest('.home-comment');
			const form = comment?.querySelector<HTMLFormElement>(
				'.home-reply-form'
			);

			if (!form) return;

			const isOpening = form.hidden;

			// Close other reply forms
			list.querySelectorAll<HTMLFormElement>('.home-reply-form').forEach(
				(otherForm) => {
					otherForm.hidden = true;
				}
			);

			list.querySelectorAll<HTMLButtonElement>(
				'.home-comment-reply-button'
			).forEach((button) => {
				button.setAttribute('aria-expanded', 'false');
			});

			form.hidden = !isOpening;
			replyButton.setAttribute('aria-expanded', String(isOpening));

			if (isOpening) {
				form.querySelector<HTMLTextAreaElement>(
					'.home-reply-input'
				)?.focus();
			}

			return;
		}

		// Cancel a reply
		const cancelButton = target.closest<HTMLButtonElement>(
			'.home-reply-cancel'
		);

		if (cancelButton) {
			const form = cancelButton.closest<HTMLFormElement>(
				'.home-reply-form'
			);

			if (form) {
				form.hidden = true;
				form.reset();

				const replyButton = form
					.closest('.home-comment')
					?.querySelector<HTMLButtonElement>(
						'.home-comment-reply-button'
					);

				replyButton?.setAttribute('aria-expanded', 'false');
			}

			return;
		}

		
	});

	list?.addEventListener('submit', async (event) => {
			const form = event.target;

			if (!(form instanceof HTMLFormElement)) return;
			if (!form.matches('.home-reply-form')) return;

			event.preventDefault();

			const parentId = form.dataset.parentId;
			const replyInput = form.querySelector<HTMLTextAreaElement>(
				'.home-reply-input'
			);
			const submitButton = form.querySelector<HTMLButtonElement>(
				'.home-reply-submit'
			);
			const replyStatus = form.querySelector<HTMLElement>(
				'.home-reply-status'
			);

			if (!parentId || !replyInput || !submitButton || !replyStatus) return;

			const body = replyInput.value.trim();

			if (!body) {
				replyStatus.textContent = 'Please write a reply first.';
				return;
			}

			const { data: { user } } = await supabase.auth.getUser();

			if (!user) {
				window.location.href = '/login';
				return;
			}

			submitButton.disabled = true;
			replyStatus.textContent = 'Posting reply...';

			const { data: profile, error: profileError } = await supabase
				.from('profiles')
				.select('username')
				.eq('id', user.id)
				.maybeSingle();

			if (profileError || !profile) {
				console.error('Reply profile error:', profileError);
				replyStatus.textContent = 'Could not load your profile.';
				submitButton.disabled = false;
				return;
			}

			const { error } = await supabase
				.from('comments')
				.insert({
					post_id: HOME_POST_ID,
					parent_id: parentId,
					user_id: user.id,
					display_name: profile.username,
					body
				});

			if (error) {
				console.error('Reply posting error:', error);
				replyStatus.textContent = 'Could not post your reply.';
				submitButton.disabled = false;
				return;
			}

			await loadHomeComments();
			if (status) status.textContent = 'Reply posted!';
		});

    postButton?.addEventListener('click', async () => {
        if (!input || !status || !postButton) return;

        const { data: { user } } = await supabase.auth.getUser();

        if (!user) {
            window.location.href = '/login';
            return;
        }

        const body = input.value.trim();

        if (!body) {
            status.textContent = 'Please write a comment first.';
            return;
        }

        postButton.disabled = true;
        status.textContent = 'Posting...';

        const { data: profile, error: profileError } = await supabase
            .from('profiles')
            .select('username')
            .eq('id', user.id)
            .maybeSingle();

        if (profileError || !profile) {
            console.error('Profile error:', profileError);
            status.textContent = 'Could not load your profile.';
            postButton.disabled = false;
            return;
        }

        const { error } = await supabase
            .from('comments')
            .insert({
                post_id: HOME_POST_ID,
                user_id: user.id,
                display_name: profile.username,
                body,
                parent_id: null,
            });

        if (error) {
            console.error('Homepage comment post error:', error);
            status.textContent = 'Could not post your comment.';
            postButton.disabled = false;
            return;
        }

        input.value = '';
        status.textContent = 'Comment posted!';
        postButton.disabled = false;

        await loadHomeComments();

		
    });

    loadHomeComments();

	const copyButton = document.querySelector('#copy-link');

	if (copyButton instanceof HTMLButtonElement) {
		copyButton.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);

				copyButton.textContent = '✓ Link Copied!';

				setTimeout(() => {
					copyButton.textContent = '🔗 Copy Link';
				}, 2000);
			} catch (error) {
				console.error('Could not copy link:', error);
				copyButton.textContent = 'Copy failed';

				setTimeout(() => {
					copyButton.textContent = '🔗 Copy Link';
				}, 2000);
			}
		});
	}
</script>
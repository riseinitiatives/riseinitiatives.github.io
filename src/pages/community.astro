	</style>


	<script>
	import { supabase } from '../lib/supabase';


	const tabs =
		document.querySelectorAll<HTMLButtonElement>('.community-tab');

	const feed =
		document.querySelector<HTMLElement>('#community-feed-list');

	const emptyState =
		document.querySelector<HTMLElement>('#community-empty');
	
	const sortSelect =
    document.querySelector<HTMLSelectElement>('#community-sort');

	let currentCategory = 'all';
	let currentSort = 'top';		
	let allPosts: any[] = [];
	let currentUser: any = null;

	const discussionModal =
		document.querySelector<HTMLElement>('#discussion-modal');

	const openDiscussionButton =
		document.querySelector<HTMLButtonElement>('#open-discussion-modal');

	const openDiscussionBottom =
		document.querySelector<HTMLButtonElement>(
			'#open-discussion-modal-bottom'
		);

	const closeDiscussionButton =
		document.querySelector<HTMLButtonElement>(
			'#close-discussion-modal'
		);

	const cancelDiscussionButton =
		document.querySelector<HTMLButtonElement>(
			'#cancel-discussion'
		);

	const discussionModalBackdrop =
		document.querySelector<HTMLElement>(
			'#discussion-modal-backdrop'
		);

	function openDiscussionModal() {
		discussionModal?.removeAttribute('hidden');
	}

	function closeDiscussionModal() {
		discussionModal?.setAttribute('hidden', '');
	}

	openDiscussionButton?.addEventListener(
		'click',
		openDiscussionModal
	);

	openDiscussionBottom?.addEventListener(
		'click',
		openDiscussionModal
	);

	closeDiscussionButton?.addEventListener(
		'click',
		closeDiscussionModal
	);

	cancelDiscussionButton?.addEventListener(
		'click',
		closeDiscussionModal
	);

	discussionModalBackdrop?.addEventListener(
		'click',
		closeDiscussionModal
	);


	/* =========================================================
	   HELPERS
	========================================================= */

	function escapeHtml(value: string) {
		return value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#039;');
	}


	function formatTime(dateString: string) {

		const date = new Date(dateString);

		const seconds =
			Math.floor(
				(Date.now() - date.getTime()) / 1000
			);


		if (seconds < 60) {
			return 'just now';
		}


		const minutes =
			Math.floor(seconds / 60);


		if (minutes < 60) {
			return `${minutes}m ago`;
		}


		const hours =
			Math.floor(minutes / 60);


		if (hours < 24) {
			return `${hours}h ago`;
		}


		const days =
			Math.floor(hours / 24);


		if (days < 7) {
			return `${days}d ago`;
		}


		return date.toLocaleDateString(
			'en-IN',
			{
				day: 'numeric',
				month: 'short',
				year: 'numeric',
			}
		);
	}


	function getCategoryIcon(category: string) {

		if (category === 'Ideas') {
			return '💡';
		}

		if (category === 'Projects') {
			return '🚀';
		}

		if (category === 'Build & Tech') {
			return '🛠️';
		}

		return '✦';
	}


	/* =========================================================
	   RENDER POSTS
	========================================================= */

	function renderPosts() {
    if (!feed) return;

    const posts = allPosts
        .filter((post) =>
            currentCategory === 'all' ||
            post.category === currentCategory
        )
        .sort((a, b) => {
            // Highest upvotes first; newest breaks ties
            if (currentSort === 'top') {
                const upvoteDifference =
                    (b.upvote_count ?? 0) - (a.upvote_count ?? 0);

                if (upvoteDifference !== 0) {
                    return upvoteDifference;
                }
            }

            // Newest first
            return new Date(b.created_at).getTime()
                - new Date(a.created_at).getTime();
        });


		if (posts.length === 0) {

			feed.innerHTML = '';

			if (emptyState) {
				emptyState.classList.remove('hidden');
			}

			return;
		}


		if (emptyState) {
			emptyState.classList.add('hidden');
		}


		feed.innerHTML = posts.map((post) => {

			const username =
				post.username || 'RISE User';

			const firstLetter =
				username.charAt(0).toUpperCase();


			const title =
				escapeHtml(post.title);

			const body =
				escapeHtml(post.body);

			const safeUsername =
				escapeHtml(username);

			const categoryName =
				escapeHtml(post.category);


			return `
				<article
					class="community-post"
					data-category="${categoryName}"
					data-post-id="${post.id}"
				>

					<div class="post-top">

						<div class="post-category">
							<span>${getCategoryIcon(post.category)}</span>
							${categoryName}
						</div>

						<div class="post-options">

							<span class="post-time">
								${formatTime(post.created_at)}
							</span>

							${
								currentUser?.id === post.user_id
									? `
										<div class="post-menu-container">

											<button
												class="post-menu-button"
												data-post-id="${post.id}"
												type="button"
												aria-label="Discussion options"
											>
												⋮
											</button>

											<div
												class="post-menu"
												data-menu-id="${post.id}"
												hidden
											>
												<button
													class="post-delete"
													data-post-id="${post.id}"
													type="button"
												>
													Delete
												</button>
											</div>

										</div>
									`
									: ''
							}

						</div>

					</div>


					<a
						href="#"
						class="post-title"
						data-post-id="${post.id}"
					>
						${title}
					</a>


					<p class="post-preview">
						${body}
					</p>


					<div class="post-meta">

						<div class="post-author">

							<div class="author-avatar" data-fallback="${firstLetter}">
								${
									post.avatar_url
										? `<img
											src="${escapeHtml(post.avatar_url)}"
											alt="@${safeUsername}"
											loading="lazy"
											style="display:block;width:30px;height:30px;min-width:30px;max-width:30px;min-height:30px;max-height:30px;object-fit:cover;"
										/>`
										: firstLetter
								}
							</div>

							<span>
								@${safeUsername}
							</span>

						</div>


						<div class="post-stats">
							<span>▲ ${post.upvote_count ?? 0}</span>
							<span>💬 ${post.comment_count ?? 0}</span>
						</div>

					</div>

				</article>
			`;

		}).join('');

		// Fallback for unavailable profile pictures
		feed
			.querySelectorAll<HTMLImageElement>('.author-avatar img')
			.forEach((img) => {
				img.addEventListener('error', () => {
					const avatar = img.closest<HTMLElement>(
						'.author-avatar'
					);

					if (!avatar) return;

					avatar.textContent =
						avatar.dataset.fallback || 'R';
				}, { once: true });
			});


		/* Prevent placeholder links from jumping */

		feed
			.querySelectorAll<HTMLAnchorElement>('.post-title')
			.forEach((link) => {

				link.addEventListener('click', (event) => {
					event.preventDefault();

					const postId =
						link.dataset.postId;

					if (!postId) return;

					window.location.href =
						`/community/post?id=${postId}`;
				});

			});

		feed
			.querySelectorAll<HTMLButtonElement>('.post-menu-button')
			.forEach((button) => {

				button.addEventListener('click', (event) => {

					event.stopPropagation();

					const postId =
						button.dataset.postId;

					if (!postId) return;

					feed
						.querySelectorAll<HTMLElement>('.post-menu')
						.forEach((menu) => {

							if (menu.dataset.menuId === postId) {
								menu.toggleAttribute('hidden');
							} else {
								menu.setAttribute('hidden', '');
							}

						});

				});

			});	

		feed
			.querySelectorAll<HTMLButtonElement>('.post-delete')
			.forEach((button) => {

				button.addEventListener('click', async () => {

					const postId = button.dataset.postId;

					if (!postId) return;

					const confirmed =
						window.confirm('Delete this discussion?');

					if (!confirmed) return;

					const { error } =
						await supabase
							.from('community_posts')
							.delete()
							.eq('id', postId)
							.eq('user_id', currentUser?.id);

					if (error) {
						console.error(
							'Delete discussion error:',
							error
						);

						return;
					}

					await loadCommunityPosts();
				});

			});	
	}


	/* =========================================================
	   LOAD COMMUNITY POSTS
	========================================================= */

	async function loadCommunityPosts() {


		if (!feed) return;

		const {
			data: { user },
		} = await supabase.auth.getUser();

		currentUser = user;


		feed.innerHTML = `
			<div class="community-loading">
				Loading discussions...
			</div>
		`;


		const {
			data: posts,
			error: postsError,
		} = await supabase
			.from('community_posts')
			.select(`
				id,
				user_id,
				title,
				body,
				category,
				created_at,
				updated_at
			`)
			.order('created_at', {
				ascending: false,
			});
		
	

		if (postsError) {

			console.error(
				'Community posts error:',
                JSON.stringify(postsError, null, 2)
			);

			feed.innerHTML = `
				<div class="community-loading">
					Unable to load discussions.
				</div>
			`;

			return;
		}



		if (!posts || posts.length === 0) {

			allPosts = [];

			feed.innerHTML = '';

			if (emptyState) {
				emptyState.classList.remove('hidden');
			}

			return;
		}


		/* =====================================================
		   LOAD PUBLIC RISE USERNAMES
		===================================================== */

		const userIds = [
			...new Set(
				posts.map(
					(post) => post.user_id
				)
			),
		];


		const {
			data: profiles,
			error: profilesError,
		} = await supabase
			.from('profiles')
			.select('id, username, avatar_url')
			.in('id', userIds);


		if (profilesError) {

			console.error(
				'Profiles error:',
				profilesError
			);

		}


		const profileMap =
			new Map(
				(profiles || []).map(
					(profile) => [
						profile.id,
						{
							username: profile.username,
							avatar_url: profile.avatar_url,
						},
					]
				)
			);


		/* =====================================================
		   COMBINE POSTS + USERNAMES
		===================================================== */

		allPosts =
            posts.map((post) => {

                const profile =
                    profileMap.get(post.user_id);

                return {
                    ...post,

                    username:
                        profile?.username
                        || 'RISE User',

                    avatar_url:
                        profile?.avatar_url
                        || null,

                    upvote_count: 0,
                    comment_count: 0,
                };

            });

        // Load upvotes and comments for the fetched posts
        const postIds = allPosts.map((post) => post.id);


        const [
            { data: upvotes, error: upvotesError },
            { data: comments, error: commentsError },
        ] = await Promise.all([
            supabase
                .from('upvotes')
                .select('post_id')
                .in('post_id', postIds),

            supabase
                .from('comments')
                .select('post_id')
                .in('post_id', postIds),
        ]);


        if (upvotesError) {
            console.error('Upvote count error:', upvotesError);
        }

        if (commentsError) {
            console.error('Comment count error:', commentsError);
        }

        const upvoteCounts = new Map<string, number>();
        const commentCounts = new Map<string, number>();

        (upvotes || []).forEach(({ post_id }) => {
            upvoteCounts.set(
                post_id,
                (upvoteCounts.get(post_id) || 0) + 1
            );
        });

        (comments || []).forEach(({ post_id }) => {
            commentCounts.set(
                post_id,
                (commentCounts.get(post_id) || 0) + 1
            );
        });

        allPosts = allPosts.map((post) => ({
            ...post,
            upvote_count: upvoteCounts.get(post.id) || 0,
            comment_count: commentCounts.get(post.id) || 0,
        }));


        renderPosts();
	}	






	/* =========================================================
	CATEGORY FILTERS
	========================================================= */

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			currentCategory = tab.dataset.category || 'all';

			tabs.forEach((item) => {
				item.classList.remove('active');
			});

			tab.classList.add('active');

			renderPosts();
		});
	});

	/* =========================================================
	POST SORTING
	========================================================= */

	sortSelect?.addEventListener('change', () => {
		currentSort = sortSelect.value;
		renderPosts();
	});

	/* =========================================================
	   START
	========================================================= */

	loadCommunityPosts();


	
</script>

</html>